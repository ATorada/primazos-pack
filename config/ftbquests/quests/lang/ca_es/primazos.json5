  "chapter.43D8126DC96590CE.title": "&7› &6Assalts i il·lagers",
  "quest.4C184774761E4952.title": "&cCoets dels saquejadors",
  "quest.4C184774761E4952.quest_subtitle": "&7Cada 10 nivells del jugador MÉS PROPER, els seus coets porten una…",
  "quest.4C184774761E4952.quest_desc": [
    "&r&7Cada 10 nivells del jugador &r&dMÉS PROPER&r&7, els seus coets porten una explosió més.",
    "&7Des del nivell 75 disparen 3 coets alhora.",
    "",
    "&eDany per coet en difícil:",
    "&r&7Nivell 20: &r&c6,8 ❤&r&7   Nivell 40: &r&c9,8 ❤ Nivell 60: &r&c12,8 ❤&r&7   Nivell 90: &r&c17,3 ❤",
    "",
    "&7Exploten en àrea. Tens 10 ❤ en total.",
    "",
    "&r&7Coet Perdut: el &r&e&lSol&r&7 desfà el 20% dels coets abans que arribin."
  ],
  "quest.4E8F409FF7102984.title": "&fAmb armadura de FERRO",
  "quest.4E8F409FF7102984.quest_subtitle": "&7Un coet de nivell 60 et treu:",
  "quest.4E8F409FF7102984.quest_desc": [
    "&7Un coet de nivell 60 et treu:",
    "",
    "&r&7Sense encantar → &r&c11,2 ❤",
    "&r&eProtecció IV ×4 → &r&c4 ❤",
    "&r&aProt. explosions IV ×4 → &r&c2,2 ❤",
    "",
    "&7Sense encantar, un sol coet et mata."
  ],
  "quest.471D2D91C7F7E177.title": "&bAmb armadura de DIAMANT",
  "quest.471D2D91C7F7E177.quest_subtitle": "&7Un coet de nivell 60 et treu:",
  "quest.471D2D91C7F7E177.quest_desc": [
    "&7Un coet de nivell 60 et treu:",
    "",
    "&r&7Sense encantar → &r&c5,8 ❤",
    "&r&eProtecció IV ×4 → &r&c2,1 ❤ Prot. explosions IV ×4 → &r&c1,2 ❤"
  ],
  "quest.44D107455EA71E9B.title": "&6Amb armadura de NETHERITA",
  "quest.44D107455EA71E9B.quest_subtitle": "&7Un coet de nivell 60 et treu:",
  "quest.44D107455EA71E9B.quest_desc": [
    "&7Un coet de nivell 60 et treu:",
    "",
    "&r&7Sense encantar → &r&c5,2 ❤",
    "&r&eProtecció IV ×4 → &r&c1,9 ❤ Prot. explosions IV ×4 → &r&c1 ❤"
  ],
  "quest.48A5F45DC2AE4CBC.title": "&dAmb NETHERITA I DIAMANT",
  "quest.48A5F45DC2AE4CBC.quest_subtitle": "&7Un coet de nivell 60 et treu:",
  "quest.48A5F45DC2AE4CBC.quest_desc": [
    "&7Un coet de nivell 60 et treu:",
    "",
    "&r&7Sense encantar → &r&c2,5 ❤",
    "&r&eProtecció IV ×4 → &r&c0,9 ❤ Prot. explosions IV ×4 → &r&c0,5 ❤",
    "",
    "&7Ja arriba al màxim de protecció contra aquest coet. La netherita i aeterni, i la netherita i siftita, aguanten millor els cops encara més forts."
  ],
  "quest.46F70611939EB189.title": "&aCom protegir-te",
  "quest.46F70611939EB189.quest_subtitle": "&7Els coets compten com a EXPLOSIÓ: la Protecció contra explosions…",
  "quest.46F70611939EB189.quest_desc": [
    "&7Els coets compten com a EXPLOSIÓ&r&7: la Protecció contra explosions els atura molt millor que la Protecció normal.",
    "",
    "&r&7Enlluernament: de vegades el &r&e&lSol frena vindicadors, inquisidors i marauders.",
    "",
    "&r&7L'&r&dESCUT&r&7 bloqueja els coets de cara.",
    "",
    "&7Ves amb el jugador de nivell més BAIX&r&7 a prop: els saquejadors fan servir el nivell del jugador més proper."
  ],
  "quest.46E15D7D143DFD32.title": "&aRecompenses en guanyar",
  "quest.46E15D7D143DFD32.quest_subtitle": "&7Heroi del poble:",
  "quest.46E15D7D143DFD32.quest_desc": [
    "&eHeroi del poble:",
    "&r&7Els vilatans et fan &r&dDESCOMPTES&r&7 i et llancen regals. Com més fort el Mal presagi, millor el descompte.",
    "",
    "&7A més, els illagers deixen anar el seu botí: l'Evocador un &r&dTÒTEM&r&7, el devastador una muntura, el capità una ampolla ominosa...",
    "",
    "&ede cadascun."
