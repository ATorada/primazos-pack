  "chapter.4DB240077E0917AE.title": "&a&lÈgida de Protecció",
  "quest.4A7ECEFFB1CE929A.title": "&a&lÈgida&r&7",
  "quest.4A7ECEFFB1CE929A.quest_subtitle": "Si mors diverses vegades seguides.",
  "quest.4A7ECEFFB1CE929A.quest_desc": [
    "En reaparèixer, l'&a&lÈgida&r&7 et cobreix durant &d15 minuts&7:",
    "&aVelocitat, Regeneració i Força&7",
    "Com més morts seguides (fins a 5), més fort.",
    "",
    "&eSota l'aigua, a més: &bApnea i Visió nocturna&7",
    "",
    "&eProbabilitat d'un &dTÒTEM&7&e:",
    "&71: &f5%&7 · 2: &f10%&7 · 3: &f15%&7 · 4: &f25%&7 · 5: &650%",
    "",
    "&8No s'activa si et mata un altre jugador."
  ],
  "quest.4676ADFB8603167E.title": "&6Generadors encegats",
  "quest.4676ADFB8603167E.quest_subtitle": "Els generadors treuen menys monstres.",
  "quest.4676ADFB8603167E.quest_desc": [
    "Els raigs del &e&lSol&r&7 encegen els generadors: en treuen molts menys monstres del normal.",
    "",
    "&8Monuments, torres i generadors de prova."
  ],
  "quest.4BD515C40CD0CD0C.title": "&bEvaporació Instantània",
  "quest.4BD515C40CD0CD0C.quest_subtitle": "Menys guardians.",
  "quest.4BD515C40CD0CD0C.quest_desc": [
    "Si els guardians es passen de mitosi (més de 20), el &e&lSol&r&7 n'evapora la &dMEITAT&7 sense deixar rastre."
  ],
  "quest.4C43DF55E70F0A48.title": "&6Coet Perdut",
  "quest.4C43DF55E70F0A48.quest_subtitle": "20% que un coet es desfaci.",
  "quest.4C43DF55E70F0A48.quest_desc": [
    "Cada coet que dispara un saquejador té un &d20%&7 de desfer-se en fum abans d'arribar a tu."
  ],
  "quest.4E3055876B934EA9.title": "&eEnlluernament",
  "quest.4E3055876B934EA9.quest_subtitle": "25% d'enlluernar l'illager.",
  "quest.4E3055876B934EA9.quest_desc": [
    "Quan un vindicador, inquisidor o marauder et colpeja, hi ha un &d25%&7 que el &e&lSol&r&7 l'enlluerni:",
    "&c3 ❤ de dany&7",
    "&bDèbil i gairebé congelat 10 segons&7"
  ],
  "quest.4C84E15B6B2634F6.title": "&5Forja Beneïda",
  "quest.4C84E15B6B2634F6.quest_subtitle": "20% d'un lingot extra.",
  "quest.4C84E15B6B2634F6.quest_desc": [
    "En fabricar un lingot de netherita, hi ha un &d20%&7 que el &e&lSol&r&7 te'n regali un altre."
  ],
  "quest.4B16A06875A5D051.title": "&6Calor del Sol",
  "quest.4B16A06875A5D051.quest_subtitle": "20% de ferralla extra.",
  "quest.4B16A06875A5D051.quest_desc": [
    "En treure ferralla de netherita del forn, cada una té un &d20%&7 de donar-te'n una altra.",
    "",
    "&8Traient-la tu: amb tremuges no compta."
  ],
  "quest.4480F963C9234B4A.title": "&5Plantilla Beneïda",
  "quest.4480F963C9234B4A.quest_subtitle": "25% d'una plantilla extra.",
  "quest.4480F963C9234B4A.quest_desc": [
    "En duplicar una plantilla de millora de netherita, hi ha un &d25%&7 que el &e&lSol&r&7 te'n doni una més."
  ],
  "quest.40D481890F723CF4.title": "&dBeuratge Trencat",
  "quest.40D481890F723CF4.quest_subtitle": "25% de trencar la poció d'una bruixa.",
  "quest.40D481890F723CF4.quest_desc": [
    "Cada poció que et llança una bruixa té un &d25%&7 de trencar-se a l'aire."
  ],
  "quest.4B2CACA647FCCD72.title": "&bTrident Partit",
  "quest.4B2CACA647FCCD72.quest_subtitle": "20% de trencar un trident.",
  "quest.4B2CACA647FCCD72.quest_desc": [
    "Cada trident que llança un ofegat té un &d20%&7 de trencar-se en pols d'estrelles."
  ],
  "quest.44DF2E7F9D84C824.title": "&fFletxa Perduda",
  "quest.44DF2E7F9D84C824.quest_subtitle": "15% de perdre una fletxa.",
  "quest.44DF2E7F9D84C824.quest_desc": [
    "Cada fletxa d'un esquelet (de qualsevol tipus) té un &d15%&7 de perdre's en la nit."
  ],
  "quest.4AB2F0C9EB89246A.title": "&aMetxa Apagada",
  "quest.4AB2F0C9EB89246A.quest_subtitle": "30% d'apagar un creeper.",
  "quest.4AB2F0C9EB89246A.quest_desc": [
    "Quan un creeper arriba al teu costat, hi ha un &d30%&7 que les &d&lEstrelles&r&7 li apaguin la metxa."
  ],
  "quest.40511FDA626F7CE1.title": "&7Cel Clar",
  "quest.40511FDA626F7CE1.quest_subtitle": "30% d'esborrar un phantom.",
  "quest.40511FDA626F7CE1.quest_desc": [
    "Cada phantom que apareix té un &d30%&7 que les &d&lEstrelles&r&7 l'esborrin del cel."
  ],
  "quest.4F47932405EE7D6D.title": "&2Infusió de Vida No-Morta",
  "quest.4F47932405EE7D6D.quest_subtitle": "20% de danyar el zombi que et pega.",
  "quest.4F47932405EE7D6D.quest_desc": [
    "Quan un zombi et colpeja, hi ha un &d20%&7 que rebi:",
    "&cCuració instantània: 3 ❤ de dany&7",
    "&bLentitud VI durant 5 segons&7"
  ],
  "quest.42B3A405FBB94B9F.title": "&dRefosa Estel·lar",
  "quest.42B3A405FBB94B9F.quest_subtitle": "10% de reparar una peça cada 5 min.",
  "quest.42B3A405FBB94B9F.quest_desc": [
    "Cada 5 minuts a l'aire lliure de nit, hi ha un &d10%&7 que les &d&lEstrelles&r&7 reparin &dDEL TOT&7 una peça gastada.",
    "",
    "&8Sota sostre o en coves no et veuen."
  ],
  "quest.43D07842A1056114.title": "&dConstel·lació",
  "quest.43D07842A1056114.quest_subtitle": "Més experiència en grup.",
  "quest.43D07842A1056114.quest_desc": [
    "Les &d&lEstrelles&r&7 són més boniques en companyia. De nit, a 32 blocs o menys:",
    "&73 jugadors: &f+25%",
    "&74 o més: &6+50%",
    "",
    "&8Ho veuràs a dalt de la pantalla."
  ],
  "quest.48352B8BC49CB196.title": "&e&lProtecció Solar",
  "quest.48352B8BC49CB196.quest_subtitle": "El &e&lSol&r&7&r us protegeix dels excessos.",
  "quest.48352B8BC49CB196.quest_desc": [
    "El &e&lSol&r&7 és un déu benèvol que vetlla pels jugadors de Primazos.",
    "",
    "Aquestes són les seves benediccions."
  ],
  "quest.43EDB872081104E2.title": "&d&lProtecció de les Estrelles",
  "quest.43EDB872081104E2.quest_subtitle": "Les &d&lEstrelles&r&7&r guien qui camina a la foscor.",
  "quest.43EDB872081104E2.quest_desc": [
    "Les &d&lEstrelles&r&7 són un déu benèvol. No donen poder: donen guia, perquè les nits difícils siguin una mica més fàcils.",
    "",
    "&fNomés actuen de nit (des que es fa fosc) o durant una tempesta."
  ],
  "quest.42283FA0885C276E.title": "&a&lÈgida de Protecció",
  "quest.42283FA0885C276E.quest_subtitle": "Dos déus benèvols vetllen per Primazos.",
  "quest.42283FA0885C276E.quest_desc": [
    "El &e&lSol&r&7 de dia i les &d&lEstrelles&r&7 de nit.",
    "",
    "I quan tot surt malament, l'&a&lÈgida&r&7 et cobreix."
  ],
  "chapter.49245C1C892580C8.title": "&4Monstres que escalen",
  "quest.4DC647F23DED0C4B.title": "&eCom funciona",
  "quest.4DC647F23DED0C4B.quest_subtitle": "&7Cada jugador puja 1 nivell per cada 20 minuts jugats, fins al 100.",
  "quest.4DC647F23DED0C4B.quest_desc": [
    "&7Cada jugador puja 1 nivell per cada 20 minuts jugats, fins al 100.",
    "&7",
    "&7Els monstres que apareixen a prop fan servir el nivell del jugador &r&dMÉS PROPER&r&7.",
    "&7",
    "&7Si vas amb algú de nivell alt, els monstres del seu voltant seran més durs per a tothom.",
    "&7",
    "&7A &dYoth&7 no compta: el teu nivell &dni puja ni baixa&7 i els monstres d'allà no milloren."
  ],
  "quest.471998B7E9B2D38F.title": "&2Zombis",
  "quest.471998B7E9B2D38F.quest_subtitle": "&7Nivell 25: +25% vida, +38% dany.",
  "quest.471998B7E9B2D38F.quest_desc": [
    "&7&6&lNivell 25&r&7: &c+25% vida&7, &c+38% dany&7.",
    "&7&6&lNivell 50&r&7: &c+50% vida&7, &c+75% dany&7.",
    "&7&6&lNivell 100&r&7: &cel doble&7 de vida i &c+150% dany&7, i criden reforços."
  ],
  "quest.4AD5E99117F257D7.title": "&fEsquelets",
  "quest.4AD5E99117F257D7.quest_subtitle": "&7Nivell 25: +25% vida, arc amb Poder I.",
  "quest.4AD5E99117F257D7.quest_desc": [
    "&7&6&lNivell 25&r&7: &c+25% vida&7, arc amb &cPoder I&7.",
    "&7&6&lNivell 50&r&7: &c+50% vida&7, &cPoder II&7 i &carmadura&7.",
    "&7&6&lNivell 100&r&7: doble vida, &cPoder V&7, Impuls i Flama."
  ],
  "quest.40A3F7D3C2DF97E8.title": "&8Aranyes",
  "quest.40A3F7D3C2DF97E8.quest_subtitle": "&7Les que guanyen més vida:",
  "quest.40A3F7D3C2DF97E8.quest_desc": [
    "&7Les que guanyen més vida:",
    "&7&6&lNivell 25&r&7: &c+75% vida&7.",
    "&7&6&lNivell 50&r&7: &c+150% vida&7.",
    "&7&6&lNivell 100&r&7: &cquatre vegades&7 més vida."
  ],
  "quest.4EAB4B2498695AF2.title": "&aCreepers",
  "quest.4EAB4B2498695AF2.quest_subtitle": "&7Exploten abans i més fort.",
  "quest.4EAB4B2498695AF2.quest_desc": [
    "&7Exploten abans i més fort.",
    "&7&6&lNivell 50&r&7: radi d'explosió 4.",
    "&7&6&lNivell 100&r&7: radi 6 i metxa molt més curta."
  ],
  "quest.4D60181555FDC5B2.title": "&bGuardians",
  "quest.4D60181555FDC5B2.quest_subtitle": "&7Nivell 50: +75% vida i armadura.",
  "quest.4D60181555FDC5B2.quest_desc": [
    "&7&6&lNivell 50&r&7: &c+75% vida i &carmadura&7&7.",
    "&7&6&lNivell 100&r&7: &c+150% vida i +25% dany&7."
  ],
  "quest.43BAF7436C24984B.title": "&3Ofegats",
  "quest.43BAF7436C24984B.quest_subtitle": "&7Nivell 50: +75% vida, la meitat porten trident.",
  "quest.43BAF7436C24984B.quest_desc": [
    "&7&6&lNivell 50&r&7: &c+75% vida&7, la meitat porten &ctrident&7.",
    "&7&6&lNivell 100&r&7: &c+150% vida i tots amb &ctrident&7&7."
  ],
  "quest.4BD80EE2EF4F3106.title": "&7Saquejadors i illagers",
  "quest.4BD80EE2EF4F3106.quest_subtitle": "&7Més vida, armadura i dany. Els saquejadors arriben a disparar coets…",
  "quest.4BD80EE2EF4F3106.quest_desc": [
    "&7Més vida, &carmadura&7 i dany. Els saquejadors arriben a disparar coets de focs artificials."
