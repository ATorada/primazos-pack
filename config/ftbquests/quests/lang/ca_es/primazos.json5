  "chapter.49A60DE5C0DDB051.title": "&6&l★ Comença aquí",
  "quest.4227C911EB0F1706.title": "&eCom llegir aquest llibre",
  "quest.4227C911EB0F1706.quest_subtitle": "Què significa cada forma i cada color.",
  "quest.4227C911EB0F1706.quest_desc": [
    "&fCercle&7: un pas de la teva aventura. Es completa sol quan l'aconsegueixes i dona &6recompenses&7.",
    "&fRombe&7: un cap.",
    "&fHexàgon&7: com funciona el servidor.",
    "&fQuadrat&7: informació.",
    "&fFemella&7: el resum d'una secció. Quan tingui la &e&l!&r&7, obre-la i recull la teva &6experiència&7.",
    "",
    "Les &dparaules clau&7 van en rosa, els &cperills&7 en vermell i les &6recompenses&7 en daurat."
  ],
  "quest.464931B3842EB6E2.title": "&eCom obrir el llibre",
  "quest.464931B3842EB6E2.quest_subtitle": "Botó Progrés, el llibre o una comanda.",
  "quest.464931B3842EB6E2.quest_desc": [
    "Prem &e&lEsc&r&7 i el botó &6Progrés&7.",
    "",
    "En entrar et donem l'&6Atles de Primazos&7: fes-hi clic dret.",
    "",
    "També: &e&l/ftbquests open_book&r&7, o assigna una tecla a Opcions → Controls → FTB Quests."
  ],
  "quest.4CA0580DF13FA630.title": "&a&lAventura",
  "quest.4CA0580DF13FA630.quest_subtitle": "Què fer ara. Avança pas a pas.",
  "quest.4CA0580DF13FA630.quest_desc": [
    "La zona amb &dprogrés&7: cada pas es completa sol quan ho aconsegueixes i dona &6recompenses&7.",
    "",
    "Primers dies → El Món → El Nether → L'End → The Sift."
  ],
  "quest.44EFBB7B0E4010DF.title": "&f&lEquip",
  "quest.44EFBB7B0E4010DF.quest_subtitle": "Armadures, armes i encanteris.",
  "quest.44EFBB7B0E4010DF.quest_desc": [
    "Quin equip és millor, com millorar-lo i quins encanteris posar-li.",
    "",
    "La &dNetherita avançada&7 també dona recompenses en aconseguir cada lingot."
  ],
  "quest.4E9317F3918612F9.title": "&b&lEl Servidor",
  "quest.4E9317F3918612F9.quest_subtitle": "Com funciona Primazos.",
  "quest.4E9317F3918612F9.quest_desc": [
    "Els sistemes propis del servidor: l'&a&lÈgida&r&7, el &e&lSol&r&7, les &d&lEstrelles&r&7, els controls i què passa en morir."
  ],
  "quest.42734208667D6698.title": "&6&lEnciclopèdia",
  "quest.42734208667D6698.quest_subtitle": "Tots els mods del pack per temes.",
  "quest.42734208667D6698.quest_desc": [
