  "quest.4D8431B3AF6BB688.title": "&fFase 2: Ferro i explorar",
  "quest.4D8431B3AF6BB688.quest_subtitle": "&7Armadura de ferro i escut. Explora estructures fàcils i busca ulls…",
  "quest.4D8431B3AF6BB688.quest_desc": [
    "&7Armadura de ferro i escut. Explora estructures fàcils i busca ulls de l'End des d'ara."
  ],
  "quest.4667020EDA4B9FE1.title": "&bFase 3: Diamant i Nether",
  "quest.4667020EDA4B9FE1.quest_subtitle": "&7Ves al Nether amb diamant i una peça d'or. Les fortaleses i pobles…",
  "quest.4667020EDA4B9FE1.quest_desc": [
    "&7Ves al Nether amb diamant i una peça d'or. Les fortaleses i pobles del Nether són del més perillós. BetterNether et dona cincinnasita i robins."
  ],
  "quest.4596518D509AC349.title": "&8Fase 4: Netherita",
  "quest.4596518D509AC349.quest_subtitle": "&7Busca restes antigues i passa-ho tot a netherita. Encanta bé el teu…",
  "quest.4596518D509AC349.quest_desc": [
    "&7Busca restes antigues i passa-ho tot a netherita. Encanta bé el teu equip."
  ],
  "quest.41EF52622DC8DDF7.title": "&bFase 5: Netherita avançada",
  "quest.41EF52622DC8DDF7.quest_subtitle": "&7Millora a netherita de ferro, or, maragda i finalment diamant…",
  "quest.41EF52622DC8DDF7.quest_desc": [
    "&7Millora a netherita de ferro, or, maragda i finalment diamant (defensa 26). Més endavant tindrà dues millores més: aeterni i siftita."
  ],
  "quest.496AF721CFBDE226.title": "&3Fase 6: Obrir l'End",
  "quest.496AF721CFBDE226.quest_subtitle": "&7Reuneix els ulls especials d'End Remastered i prepara't per a la…",
  "quest.496AF721CFBDE226.quest_desc": [
    "&7Reuneix els ulls especials d'End Remastered i prepara't per a la dragona remasteritzada. Millor en grup."
  ],
  "quest.4DFD392D27514515.title": "&5Fase 7: L'End de veritat",
  "quest.4DFD392D27514515.quest_subtitle": "&7Explora BetterEnd: terminita, cristal·lita i aeterni. Amb 4 lingots…",
  "quest.4DFD392D27514515.quest_desc": [
    "&7Explora BetterEnd: terminita, cristal·lita i aeterni. Amb 4 lingots d'aeterni i un lingot de netherita i diamant fas netherita i aeterni (defensa 28, i els shulkers ja no t'aixequen). Les ciutats de l'End i els èlitres."
  ],
  "quest.4C5C2202670202A5.title": "&3Fase 8: The Sift i caps",
  "quest.4C5C2202670202A5.quest_subtitle": "&7Amb tot l'anterior, explora The Sift, els caps i les masmorres més…",
  "quest.4C5C2202670202A5.quest_desc": [
    "&7Amb tot l'anterior, explora The Sift, els caps i les masmorres més difícils.",
    "",
    "&7The Sift no té masmorres: amb 4 lingots de siftita i un lingot de netherita i aeterni fas netherita i siftita, el millor equip del modpack (defensa 30, resisteix la foscor). El Sifter pica com un mob d'elit."
  ],
