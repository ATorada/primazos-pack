  "chapter.4D9A475CF55E2077.title": "&7› &6Useless Reptile",
  "quest.4EB01E40F3569BDA.title": "&2Wyvern de pantà",
  "quest.4EB01E40F3569BDA.quest_subtitle": "&7On: aiguamolls.",
  "quest.4EB01E40F3569BDA.quest_desc": [
    "&bOn: pantans.",
    "&eDomesticar-lo:",
    "&r&7Dona-li 1-2 piles de &r&dpollastre&r&7 (cru o cuinat) o 4 piles de qualsevol altra carn (val la carn podrida).",
    "&eObjectes:",
    "&r&dSella&r&7 o &r&dSella&r&7 &r&ddoble&r&7 (per anar-hi dos). Amb un &r&dflascó&r&7 &r&dbuit&r&7 n'extreus àcid, que es fa servir com una poció.",
    "&r&dNO&r&7 pot portar armadura.",
    "&eHabilitats (G i R):",
    "&r&7Escup boles d'&r&dàcid&r&7 (punteria regular) i mossega."
  ],
  "quest.4028E6C369FD4CB0.title": "&eLightning Chaser",
  "quest.4028E6C369FD4CB0.quest_subtitle": "&7On: apareix a les tempestes a prop dels jugadors.",
  "quest.4028E6C369FD4CB0.quest_desc": [
    "&bOn: apareix durant les tempestes a prop dels jugadors.",
    "&eDomesticar-lo:",
    "&7Cal vèncer-lo: baixa-li la vida i colpeja'l amb &r&d3&r&7 &r&dllamps&r&7 (trident amb &r&dCanalització&r&7).",
    "&eObjectes:",
    "&r&dSella&r&7, &r&darmadura&r&7 &r&dde&r&7 &r&ddrac (casc, pitet i cua de ferro, or, diamant o netherita) i estendards.",
    "&eHabilitats (G i R):",
    "&r&dAlè&r&7 &r&dde&r&7 &r&dllamp&r&7: trenca blocs i fa el mateix que un llamp (creepers carregats, bruixes...).",
    "&r&dOna&r&7 &r&dexpansiva&r&7 (només volant):",
    "&7desvia fletxes i empeny els mobs.",
    "&7A terra, mossega.",
    "&r&7Tots dos atacs donen &r&dShock&r&7: l'enemic va més lent, pega menys i hi veu pitjor."
  ],
  "quest.4262A3CF669E9159.title": "&6Moleclaw",
  "quest.4262A3CF669E9159.quest_subtitle": "&7On: coves.",
  "quest.4262A3CF669E9159.quest_desc": [
    "&bOn: coves.",
    "&eDomesticar-lo:",
    "&7Dona-li de mitjana una pila de remolatxa&r&7.",
    "&eObjectes:",
    "&r&dSella&r&7, &r&darmadura&r&7 &r&dde&r&7 &r&ddrac i el seu &r&dcasc&r&7 &r&dde&r&7 &r&dMoleclaw&r&7: sense el casc li fa por la llum.",
    "&eHabilitats (G i R):",
    "&r&dExcava&r&7 el que trenca un pic de fusta. Amb poció de &r&dForça&r&7 trenca blocs més durs; amb &r&dDebilitat no trenca res.",
    "&7Atacs cos a cos que toquen tot el que hi ha al davant."
  ],
  "quest.4AA866B9AC7C316F.title": "&bRiver Pikehorn",
  "quest.4AA866B9AC7C316F.quest_subtitle": "&7On: rius i platges que no estiguin glaçats.",
  "quest.4AA866B9AC7C316F.quest_desc": [
    "&bOn: rius i platges que no estiguin glaçats.",
    "&eDomesticar-lo:",
    "&r&7Una &r&dgalleda&r&7 &r&damb&r&7 &r&dpeix&r&7 &r&dtropical&r&7 o 4-8 peixos tropicals.",
    "&eObjectes:",
    "&r&7Amb la &r&dFlauta&r&7 li manes pescar per tu o atacar un mob.",
    "&r&dNO&r&7 es munta: es porta al cap (ajupeix-te i fes clic en un bloc per posar-te'l o treure-te'l).",
    "&eHabilitats:",
    "&7Només ataca cos a cos."
  ],
  "quest.466A8F910111B077.title": "&cMagmamuncher",
  "quest.466A8F910111B077.quest_subtitle": "&7On: Nether, a prop dels llacs de lava.",
  "quest.466A8F910111B077.quest_desc": [
    "&bOn: Nether, a prop dels llacs de lava.",
    "&eDomesticar-lo:",
    "&r&7Dona-li entre 4 i 12 &r&dvares&r&7 &r&dde blaze&r&7.",
    "&eObjectes:",
    "&r&dNO&r&7 es munta: es porta al cap com el Pikehorn.",
    "&r&7Si porta &r&dcombustible&r&7 a l'inventari (carbó...), et dona Resistència&r&7 &r&dal&r&7 &r&dfoc&r&7 quan t'encens.",
    "&eHabilitats:",
    "&7Excava blocs de magma (de vegades treu carbó). Les seves mossegades cremen i és immune al foc."
  ],
  "quest.4F3998BAF5DA2293.title": "&eOrdres i cures",
  "quest.4F3998BAF5DA2293.quest_subtitle": "&7Serveix per a tots els dracs domesticats:",
  "quest.4F3998BAF5DA2293.quest_desc": [
    "&7Serveix per a tots els dracs domesticats:",
    "",
    "&r&dAjupeix-te&r&7 &r&d+&r&7 &r&dclic&r&7 &r&ddret&r&7:",
    "&7obrir el seu inventari i donar-li ordres (seguir, quedar-se, seure).",
    "&r&dPal&r&7 o banya ajupit: asseure'l o aixecar-lo.",
    "&7Pocions ajupit: dona-les al drac.",
    "&7Si li poses menjar a l'inventari, menja sol."
  ],
  "quest.42CD36F88043CB23.title": "&bArmadura de drac",
  "quest.42CD36F88043CB23.quest_subtitle": "&7Casc, pitet i cua de ferro, or, diamant o netherita (la de…",
