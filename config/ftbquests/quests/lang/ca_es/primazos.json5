  "chapter.454FABAB4D9ED871.title": "&d&lYoth&r&7: via ràpida",
  "image.4E21C5C5F21BE88A.title": "&lAnar a Yoth",
  "image.45FEB1981C1A8930.title": "&lTornar",
  "quest.4EACA8D62A63C301.title": "&dQuè és Yoth",
  "quest.4EACA8D62A63C301.quest_subtitle": "&7Un món cova &damable&7 per aprendre i arribar ràpid a la &dnetherita&7.",
  "quest.4EACA8D62A63C301.quest_desc": [
    "&7Un món cova &damable&7 per aprendre i arribar ràpid a la &dnetherita&7.",
    "",
    "&7Hi ha &dmolt pocs monstres&7 i gairebé tot el del món normal: pobles, masmorres, tots els minerals i zones del Nether amb &dbastions&7.",
    "&7Les &drestes ancestrals&7 surten a &dtots els biomes&7.",
    "",
    "&7Aquí els &dmonstres que escalen&7 no compten: el teu nivell &dni puja ni baixa&7.",
    "&7El que aconsegueixis a Yoth &dte l'emportes&7 al món normal, i al revés.",
    "",
    "&cEls llits no guarden el teu punt de reaparició&7: si mors, et despertes al teu llit del món normal i la teva tomba es queda a Yoth.",
    "",
    "&7Aquest capítol &dnomés avança amb el que aconsegueixis dins de Yoth&7: fabricar, fondre, picar o recollir. El que portis de fora no compta.",
    "",
    "&7En entrar portes posada la &dllanterna de Yoth&7: els monstres et deixen en pau."
  ],
  "quest.4B8C3DC2448B1B41.title": "&d&lEntra a Yoth",
  "quest.4B8C3DC2448B1B41.quest_subtitle": "&7Prem &e&lAnar a Yoth&r&7 (a sota) i travessa el portal.",
  "quest.4B8C3DC2448B1B41.quest_desc": [
    "&7Prem &e&lAnar a Yoth&r&7 (a sota) i travessa el portal.",
    "",
    "&e&lAnar a Yoth&r&7: s'obre un &dportal&7 davant teu. En 2 segons està llest: &dtravessa'l&7.",
    "&e&lTornar&r&7: el mateix des de Yoth, i apareixes &don eres&7.",
    "",
    "&7També amb &e&l/trigger yoth set 1&r&7 (anar) i &e&l/trigger yoth set 2&r&7 (tornar).",
    "&cNo es pot obrir en ple combat&7.",
    "",
    "&7La primera vegada apareixes a l'altura d'on eres; després, al teu &darrer lloc segur&7 de Yoth.",
    "",
    "&7El portal sempre et deixa en un &dlloc segur&7 i tens uns segons de &dprotecció total&7 en arribar."
  ],
  "quest.46090082BF3B0803.title": "&fPedra i fusta",
  "quest.46090082BF3B0803.quest_subtitle": "&7Fabrica un &dpic de pedra&7.",
  "quest.46090082BF3B0803.quest_desc": [
    "&7Fabrica un &dpic de pedra&7.",
    "",
    "&7A Yoth no hi ha sol: porta &dtorxes&7 i no t'allunyis sense llum."
  ],
  "quest.4F06056A7B906436.title": "&fFerro",
  "quest.4F06056A7B906436.quest_subtitle": "&7Junta &d8 lingots de ferro&7.",
  "quest.4F06056A7B906436.quest_desc": [
    "&7Junta &d8 lingots de ferro&7.",
    "",
    "&7N'hi ha molt a les parets de les coves. Fon-lo en un forn."
  ],
  "quest.4736B846400EFFE0.title": "&fPic de ferro",
  "quest.4736B846400EFFE0.quest_subtitle": "&7Fabrica un &dpic de ferro&7: ja pots picar &ddiamant&7 i &dor&7.",
  "quest.4736B846400EFFE0.quest_desc": [
    "&7Fabrica un &dpic de ferro&7: ja pots picar &ddiamant&7 i &dor&7."
  ],
  "quest.4FE98792CFBB4DDF.title": "&dLa llanterna de Yoth",
  "quest.4FE98792CFBB4DDF.quest_subtitle": "&7A Yoth portes sempre una &dllanterna d'ametista&7 al cinturó.",
  "quest.4FE98792CFBB4DDF.quest_desc": [
    "&7A Yoth portes sempre una &dllanterna d'ametista&7 al cinturó.",
    "",
    "&7Es posa sola en entrar, &dno es pot treure&7 i desapareix en sortir o en morir.",
    "&7- Els monstres propers &ds'aparten&7 i no et persegueixen.",
    "&7- Si &cels colpeges&7, aquell monstre es defensa durant 15 segons.",
    "&7- Apareixen &dmenys monstres&7 al teu voltant.",
    "&7- Els &ccaps&7 no en fan cas."
  ],
  "quest.49FFC7CD9BC37E56.title": "&bDiamants",
  "quest.49FFC7CD9BC37E56.quest_subtitle": "&7Aconsegueix &d3 diamants&7.",
  "quest.49FFC7CD9BC37E56.quest_desc": [
    "&7Aconsegueix &d3 diamants&7.",
    "",
    "&7Són al més fons, per sota de la capa 0. Explora les coves grans o pica en branques."
  ],
  "quest.4C14BA8F7DC2A3C1.title": "&bPic de diamant",
  "quest.4C14BA8F7DC2A3C1.quest_subtitle": "&7Fabrica un &dpic de diamant&7: l'únic que pica les &drestes ancestrals&7.",
  "quest.4C14BA8F7DC2A3C1.quest_desc": [
    "&7Fabrica un &dpic de diamant&7: l'únic que pica les &drestes ancestrals&7."
  ],
  "quest.4045D997AE397EB5.title": "&6Restes ancestrals",
  "quest.4045D997AE397EB5.quest_subtitle": "&7Aconsegueix &d4 restes ancestrals&7.",
  "quest.4045D997AE397EB5.quest_desc": [
    "&7Aconsegueix &d4 restes ancestrals&7.",
    "",
    "&7A Yoth surten a &dtots els biomes&7, des del fons fins a la capa 140, i en vetes més grans &dper sota de la capa 30&7.",
    "&7Semblen pedra marró amb espirals i aguanten les explosions.",
    "&7Fon-les en un forn: cadascuna dona un &dfragment de netherita&7."
  ],
  "quest.426B306E73BE5A5D.title": "&eOr",
  "quest.426B306E73BE5A5D.quest_subtitle": "&7Junta &d4 lingots d'or&7.",
  "quest.426B306E73BE5A5D.quest_desc": [
    "&7Junta &d4 lingots d'or&7.",
    "",
    "&7Amb &d4 fragments de netherita&7 i &d4 lingots d'or&7 fas un lingot de netherita."
  ],
  "quest.468315DA3D9135C1.title": "&8Lingot de netherita",
  "quest.468315DA3D9135C1.quest_subtitle": "&7Fabrica un &dlingot de netherita&7.",
  "quest.468315DA3D9135C1.quest_desc": [
    "&7Fabrica un &dlingot de netherita&7.",
    "",
    "&7A la taula de treball: 4 fragments de netherita i 4 lingots d'or, en qualsevol ordre."
  ],
  "quest.43EDB52C38E79855.title": "&dPlantilla de millora de netherita",
  "quest.43EDB52C38E79855.quest_subtitle": "&7Troba-la en un &dbastió&7 de les zones del Nether de Yoth.",
  "quest.43EDB52C38E79855.quest_desc": [
    "&7Troba-la en un &dbastió&7 de les zones del Nether de Yoth.",
    "",
    "&7Les zones del Nether (boscos carmesí i distorsionat, rius de lava, incursions demoníaques) tenen &dbastions&7. La plantilla és als seus cofres.",
    "&cEls piglins t'ataquen si no portes or posat&7: posa't unes botes d'or.",
    "&7Per copiar-la: la plantilla, &d7 diamants&7 i &d1 netherrack&7."
  ],
  "quest.471327BBFCAF11E0.title": "&8Primera peça de netherita",
  "quest.471327BBFCAF11E0.quest_subtitle": "&7Millora una eina o una peça d'armadura de &ddiamant&7 a &dnetherita&7.",
  "quest.471327BBFCAF11E0.quest_desc": [
    "&7Millora una eina o una peça d'armadura de &ddiamant&7 a &dnetherita&7.",
    "",
    "&7A la &dtaula de ferreria&7: la plantilla, la peça de diamant i un lingot de netherita.",
    "&cLa plantilla es gasta&7: copia-la abans de fer-la servir."
  ],
  "quest.465AADD25710CEE9.title": "&5&lCobert de netherita",
  "quest.465AADD25710CEE9.quest_subtitle": "&7Porta l'&darmadura de netherita completa&7.",
  "quest.465AADD25710CEE9.quest_desc": [
    "&7Porta l'&darmadura de netherita completa&7.",
    "",
    "&7Ja estàs a punt per al món normal: tot el que portes &dviatja amb tu&7.",
    "&7Següent pas: la &dNetherita avançada&7, al grup &f&lEquip&r&7."
  ],
  "quest.447B564C35375558.title": "&aVia ràpida de Yoth",
  "quest.447B564C35375558.quest_subtitle": "&7De zero a netherita al món amable.",
  "quest.447B564C35375558.quest_desc": [
    "&7De zero a netherita al món amable."
  ],
