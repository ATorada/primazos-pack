  "chapter.4C8D0CBF387CF035.title": "&eRuta recomendada",
  "quest.4F77C40DB519E79B.title": "&fFase 1: Sobrevivir",
  "quest.4F77C40DB519E79B.quest_subtitle": "&7Herramientas de piedra, comida, cama y una base. Fabrica una mochila…",
  "quest.4F77C40DB519E79B.quest_desc": [
    "&7Herramientas de piedra, comida, cama y una base. Fabrica una mochila y un calendario."
  ],
  "quest.4D8431B3AF6BB688.title": "&fFase 2: Hierro y explorar",
  "quest.4D8431B3AF6BB688.quest_subtitle": "&7Armadura de hierro y escudo. Explora estructuras fáciles y busca ojos…",
  "quest.4D8431B3AF6BB688.quest_desc": [
    "&7Armadura de hierro y escudo. Explora estructuras fáciles y busca ojos del End desde ya."
  ],
  "quest.4667020EDA4B9FE1.title": "&bFase 3: Diamante y Nether",
  "quest.4667020EDA4B9FE1.quest_subtitle": "&7Ve al Nether con diamante y una pieza de oro. Las fortalezas y aldeas…",
  "quest.4667020EDA4B9FE1.quest_desc": [
    "&7Ve al Nether con diamante y una pieza de oro. Las fortalezas y aldeas del Nether son de lo más peligroso. BetterNether te da cincinnasita y rubíes."
  ],
  "quest.4596518D509AC349.title": "&8Fase 4: Netherita",
  "quest.4596518D509AC349.quest_subtitle": "&7Busca escombros ancestrales y pasa todo a netherita. Encanta bien tu…",
  "quest.4596518D509AC349.quest_desc": [
    "&7Busca escombros ancestrales y pasa todo a netherita. Encanta bien tu equipo."
  ],
  "quest.41EF52622DC8DDF7.title": "&bFase 5: Netherita avanzada",
  "quest.41EF52622DC8DDF7.quest_subtitle": "&7Mejora a netherita de hierro, oro, esmeralda y por último diamante…",
  "quest.41EF52622DC8DDF7.quest_desc": [
    "&7Mejora a netherita de hierro, oro, esmeralda y por último diamante (defensa 26). Más adelante tendrá dos mejoras más: aeternio y siftita."
  ],
  "quest.496AF721CFBDE226.title": "&3Fase 6: Abrir el End",
  "quest.496AF721CFBDE226.quest_subtitle": "&7Junta los ojos especiales de End Remastered y prepárate para la…",
  "quest.496AF721CFBDE226.quest_desc": [
    "&7Junta los ojos especiales de End Remastered y prepárate para la dragona remasterizada. Mejor en grupo."
  ],
  "quest.4DFD392D27514515.title": "&5Fase 7: El End de verdad",
  "quest.4DFD392D27514515.quest_subtitle": "&7Explora BetterEnd: terminita, cristalita y aeternio. Con 4 lingotes…",
  "quest.4DFD392D27514515.quest_desc": [
    "&7Explora BetterEnd: terminita, cristalita y aeternio. Con 4 lingotes de aeternio y un lingote de netherita y diamante haces netherita y aeternio (defensa 28, y los shulker ya no te levantan). Las ciudades del End y los élitros."
  ],
  "quest.4C5C2202670202A5.title": "&3Fase 8: The Sift y jefes",
  "quest.4C5C2202670202A5.quest_subtitle": "&7Con todo lo anterior, explora The Sift, los jefes y las mazmorras más…",
  "quest.4C5C2202670202A5.quest_desc": [
    "&7Con todo lo anterior, explora The Sift, los jefes y las mazmorras más difíciles.",
    "",
    "&7The Sift no tiene mazmorras: con 4 lingotes de siftita y un lingote de netherita y aeternio haces netherita y siftita, el mejor equipo del modpack (defensa 30, resiste la oscuridad). El Sifter pega como un mob élite."
  ],
