  "quest.4AB2F0C9EB89246A.title": "&aMecha Apagada",
  "quest.4AB2F0C9EB89246A.quest_subtitle": "30% de apagar un creeper.",
  "quest.4AB2F0C9EB89246A.quest_desc": [
