  "chapter.43D8126DC96590CE.title": "&7› &6Asaltos e illagers",
  "quest.4C184774761E4952.title": "&cCohetes de los saqueadores",
  "quest.4C184774761E4952.quest_subtitle": "&7Cada 10 niveles del jugador MÁS CERCANO, sus cohetes llevan una…",
  "quest.4C184774761E4952.quest_desc": [
    "&r&7Cada 10 niveles del jugador &r&dMÁS CERCANO&r&7, sus cohetes llevan una explosión más.",
    "&7Desde el nivel 75 disparan 3 cohetes a la vez.",
    "",
    "&eDaño por cohete en difícil:",
    "&r&7Nivel 20: &r&c6,8 ❤&r&7   Nivel 40: &r&c9,8 ❤ Nivel 60: &r&c12,8 ❤&r&7   Nivel 90: &r&c17,3 ❤",
    "",
    "&7Explotan en área. Tienes 10 ❤ en total.",
    "",
    "&r&7Cohete Perdido: el &r&e&lSol&r&7 deshace el 20% de los cohetes antes de que lleguen."
  ],
  "quest.4E8F409FF7102984.title": "&fCon armadura de HIERRO",
  "quest.4E8F409FF7102984.quest_subtitle": "&7Un cohete de nivel 60 te quita:",
  "quest.4E8F409FF7102984.quest_desc": [
    "&7Un cohete de nivel 60 te quita:",
    "",
    "&r&7Sin encantar → &r&c11,2 ❤",
    "&r&eProtección IV ×4 → &r&c4 ❤",
    "&r&aProt. explosiones IV ×4 → &r&c2,2 ❤",
    "",
    "&7Sin encantar, un solo cohete te mata."
  ],
  "quest.471D2D91C7F7E177.title": "&bCon armadura de DIAMANTE",
  "quest.471D2D91C7F7E177.quest_subtitle": "&7Un cohete de nivel 60 te quita:",
  "quest.471D2D91C7F7E177.quest_desc": [
    "&7Un cohete de nivel 60 te quita:",
    "",
    "&r&7Sin encantar → &r&c5,8 ❤",
    "&r&eProtección IV ×4 → &r&c2,1 ❤ Prot. explosiones IV ×4 → &r&c1,2 ❤"
  ],
  "quest.44D107455EA71E9B.title": "&6Con armadura de NETHERITA",
  "quest.44D107455EA71E9B.quest_subtitle": "&7Un cohete de nivel 60 te quita:",
  "quest.44D107455EA71E9B.quest_desc": [
    "&7Un cohete de nivel 60 te quita:",
    "",
    "&r&7Sin encantar → &r&c5,2 ❤",
    "&r&eProtección IV ×4 → &r&c1,9 ❤ Prot. explosiones IV ×4 → &r&c1 ❤"
  ],
  "quest.48A5F45DC2AE4CBC.title": "&dCon NETHERITA Y DIAMANTE",
  "quest.48A5F45DC2AE4CBC.quest_subtitle": "&7Un cohete de nivel 60 te quita:",
  "quest.48A5F45DC2AE4CBC.quest_desc": [
    "&7Un cohete de nivel 60 te quita:",
    "",
    "&r&7Sin encantar → &r&c2,5 ❤",
    "&r&eProtección IV ×4 → &r&c0,9 ❤ Prot. explosiones IV ×4 → &r&c0,5 ❤",
    "",
    "&7Ya llega al máximo de protección contra este cohete. Netherita y aeternio, y netherita y siftita, aguantan mejor los golpes aún más fuertes."
  ],
  "quest.46F70611939EB189.title": "&aCómo protegerte",
  "quest.46F70611939EB189.quest_subtitle": "&7Los cohetes cuentan como EXPLOSIÓN: la Protección contra explosiones…",
  "quest.46F70611939EB189.quest_desc": [
    "&7Los cohetes cuentan como EXPLOSIÓN&r&7: la Protección contra explosiones los para mucho mejor que la Protección normal.",
    "",
    "&r&7Deslumbramiento: a veces el &r&e&lSol frena a vindicadores, inquisidores y marauders.",
    "",
    "&r&7El &r&dESCUDO&r&7 bloquea los cohetes de frente.",
    "",
    "&7Ve con el jugador de nivel más BAJO&r&7 cerca: los saqueadores usan el nivel del jugador más cercano."
  ],
  "quest.46E15D7D143DFD32.title": "&aRecompensas al ganar",
  "quest.46E15D7D143DFD32.quest_subtitle": "&7Héroe de la aldea:",
  "quest.46E15D7D143DFD32.quest_desc": [
    "&eHéroe de la aldea:",
    "&r&7Los aldeanos te hacen &r&dDESCUENTOS&r&7 y te lanzan regalos. Cuanto más fuerte el Mal presagio, mejor el descuento.",
    "",
    "&7Además, los illagers sueltan su botín: el Evocador un &r&dTÓTEM&r&7, el devastador una montura, el capitán una botella ominosa...",
    "",
    "&ede cada uno."
