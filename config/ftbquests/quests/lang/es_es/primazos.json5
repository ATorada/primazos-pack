  ],
  "quest.4D41E9AE12A4C2A4.title": "&fAscensores",
  "quest.4D41E9AE12A4C2A4.quest_subtitle": "&7Pon dos ascensores en vertical:",
  "quest.4D41E9AE12A4C2A4.quest_desc": [
    "&7Pon dos ascensores en vertical:",
    "&7salta para subir y agáchate para bajar. Se pueden teñir."
