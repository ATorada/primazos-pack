  ],
  "quest.4926CA15C759C962.title": "&fArmor Statues",
  "quest.4926CA15C759C962.quest_subtitle": "&7Coloca los soportes de armadura en cualquier pose, con brazos, y sin…",
  "quest.4926CA15C759C962.quest_desc": [
    "&7Coloca los soportes de armadura en cualquier pose, con brazos, y sin necesidad de comandos."
  ],
  "quest.49C77FD642A988B5.title": "&bLitematica",
  "quest.49C77FD642A988B5.quest_subtitle": "&7Carga esquemas de construcciones como holograma para copiarlas bloque…",
  "quest.49C77FD642A988B5.quest_desc": [
