  "quest.4F1BA84280C4B810.quest_subtitle": "&7Sodium, Lithium, FerriteCore y otros hacen que el juego vaya mucho…",
  "quest.4F1BA84280C4B810.quest_desc": [
    "&7Sodium, Lithium, FerriteCore y otros hacen que el juego vaya mucho más fluido. Si va lento, baja los shaders o la distancia."
  ],
  "quest.45BA21F861210564.title": "&3Visual, sonido y rendimiento",
  "quest.45BA21F861210564.quest_subtitle": "&7Shaders, sonidos realistas, animaciones y mods que hacen que el juego…",
  "quest.45BA21F861210564.quest_desc": [
    "&7Shaders, sonidos realistas, animaciones y mods que hacen que el juego vaya fluido."
  ],
  "chapter.454FABAB4D9ED871.title": "&d&lYoth&r&7: vía rápida",
  "image.4E21C5C5F21BE88A.title": "&lIr a Yoth",
  "image.45FEB1981C1A8930.title": "&lVolver",
  "image.4A7D3E91C5B20F68.title": "&lIr al Velo",
  "image.4F18B6C2D9A47E03.title": "&lVolver",
  "quest.4EACA8D62A63C301.title": "&dQué es Yoth",
  "quest.4EACA8D62A63C301.quest_subtitle": "&7Un mundo cueva &damable&7 para aprender y llegar rápido a la &dnetherita&7.",
  "quest.4EACA8D62A63C301.quest_desc": [
    "&7Un mundo cueva &damable&7 para aprender y llegar rápido a la &dnetherita&7.",
    "",
    "&7Hay &dmuy pocos monstruos&7 y casi todo lo del mundo normal: aldeas, mazmorras, todos los minerales y zonas del Nether con &dbastiones&7.",
    "&7Los &descombros ancestrales&7 salen en &dtodos los biomas&7.",
    "",
    "&7Aquí los &dmonstruos que escalan&7 no cuentan: tu nivel &dni sube ni baja&7.",
    "&7Lo que consigas en Yoth &dte lo llevas&7 al mundo normal, y al revés.",
    "",
    "&cLas camas no guardan tu punto de reaparición&7: si mueres, despiertas en tu cama del mundo normal y tu tumba se queda en Yoth.",
    "",
    "&7Este capítulo &dsolo avanza con lo que consigas dentro de Yoth&7: fabricar, fundir, picar o recoger. Lo que traigas de fuera no cuenta.",
    "",
    "&7Al entrar llevas puesta la &dlinterna de Yoth&7: los monstruos te dejan en paz."
  ],
  "quest.4B8C3DC2448B1B41.title": "&d&lEntra en Yoth",
  "quest.4B8C3DC2448B1B41.quest_subtitle": "&7Pulsa &e&lIr a Yoth&r&7 (abajo) y cruza el portal.",
  "quest.4B8C3DC2448B1B41.quest_desc": [
    "&7Pulsa &e&lIr a Yoth&r&7 (abajo) y cruza el portal.",
    "",
    "&e&lIr a Yoth&r&7: se abre un &dportal&7 delante de ti. En 2 segundos está listo: &dcrúzalo&7.",
    "&e&lVolver&r&7: lo mismo desde Yoth, y apareces &ddonde estabas&7.",
    "",
    "&7También con &e&l/trigger yoth set 1&r&7 (ir) y &e&l/trigger yoth set 2&r&7 (volver).",
    "&cNo se puede abrir en pleno combate&7.",
    "",
    "&7La primera vez apareces a la altura de donde estabas; después, en tu &dúltimo sitio seguro&7 de Yoth.",
    "",
    "&7El portal siempre te deja en un &dsitio seguro&7 y tienes unos segundos de &dprotección total&7 al llegar."
  ],
  "quest.46090082BF3B0803.title": "&fPiedra y madera",
  "quest.46090082BF3B0803.quest_subtitle": "&7Fabrica un &dpico de piedra&7.",
  "quest.46090082BF3B0803.quest_desc": [
    "&7Fabrica un &dpico de piedra&7.",
    "",
    "&7En Yoth no hay sol: lleva &dantorchas&7 y no te alejes sin luz."
  ],
  "quest.4F06056A7B906436.title": "&fHierro",
  "quest.4F06056A7B906436.quest_subtitle": "&7Junta &d8 lingotes de hierro&7.",
  "quest.4F06056A7B906436.quest_desc": [
    "&7Junta &d8 lingotes de hierro&7.",
    "",
    "&7Abunda en las paredes de las cuevas. Fúndelo en un horno."
  ],
  "quest.4736B846400EFFE0.title": "&fPico de hierro",
  "quest.4736B846400EFFE0.quest_subtitle": "&7Fabrica un &dpico de hierro&7: ya puedes picar &ddiamante&7 y &doro&7.",
  "quest.4736B846400EFFE0.quest_desc": [
    "&7Fabrica un &dpico de hierro&7: ya puedes picar &ddiamante&7 y &doro&7."
  ],
  "quest.4FE98792CFBB4DDF.title": "&dLa linterna de Yoth",
  "quest.4FE98792CFBB4DDF.quest_subtitle": "&7En Yoth llevas siempre una &dlinterna de amatista&7 en el cinturón.",
  "quest.4FE98792CFBB4DDF.quest_desc": [
    "&7En Yoth llevas siempre una &dlinterna de amatista&7 en el cinturón.",
    "",
    "&7Se pone sola al entrar, &dno se puede quitar&7 y desaparece al salir o al morir.",
    "&7- Los monstruos cercanos &dse apartan&7 y no te persiguen.",
    "&7- Si &cles pegas&7, ese monstruo se defiende durante 15 segundos.",
    "&7- Aparecen &dmenos monstruos&7 a tu alrededor.",
    "&7- Los &cjefes&7 no le hacen caso."
  ],
  "quest.49FFC7CD9BC37E56.title": "&bDiamantes",
  "quest.49FFC7CD9BC37E56.quest_subtitle": "&7Consigue &d3 diamantes&7.",
  "quest.49FFC7CD9BC37E56.quest_desc": [
    "&7Consigue &d3 diamantes&7.",
    "",
    "&7Están en lo más hondo, por debajo de la capa 0. Explora las cuevas grandes o pica en ramas."
  ],
  "quest.4C14BA8F7DC2A3C1.title": "&bPico de diamante",
  "quest.4C14BA8F7DC2A3C1.quest_subtitle": "&7Fabrica un &dpico de diamante&7: el único que pica los &descombros ancestrales&7.",
  "quest.4C14BA8F7DC2A3C1.quest_desc": [
    "&7Fabrica un &dpico de diamante&7: el único que pica los &descombros ancestrales&7."
  ],
  "quest.4045D997AE397EB5.title": "&6Escombros ancestrales",
  "quest.4045D997AE397EB5.quest_subtitle": "&7Consigue &d4 escombros ancestrales&7.",
  "quest.4045D997AE397EB5.quest_desc": [
    "&7Consigue &d4 escombros ancestrales&7.",
    "",
    "&7En Yoth salen en &dtodos los biomas&7, desde el fondo hasta la capa 140, y en vetas más grandes &dpor debajo de la capa 30&7.",
    "&7Parecen piedra marrón con espirales y aguantan las explosiones.",
    "&7Fúndelos en un horno: cada uno da un &dfragmento de netherita&7."
  ],
  "quest.426B306E73BE5A5D.title": "&eOro",
  "quest.426B306E73BE5A5D.quest_subtitle": "&7Junta &d4 lingotes de oro&7.",
  "quest.426B306E73BE5A5D.quest_desc": [
    "&7Junta &d4 lingotes de oro&7.",
    "",
    "&7Con &d4 fragmentos de netherita&7 y &d4 lingotes de oro&7 haces un lingote de netherita."
  ],
  "quest.468315DA3D9135C1.title": "&8Lingote de netherita",
  "quest.468315DA3D9135C1.quest_subtitle": "&7Fabrica un &dlingote de netherita&7.",
  "quest.468315DA3D9135C1.quest_desc": [
    "&7Fabrica un &dlingote de netherita&7.",
    "",
    "&7En la mesa de crafteo: 4 fragmentos de netherita y 4 lingotes de oro, en cualquier orden."
  ],
  "quest.43EDB52C38E79855.title": "&dPlantilla de mejora de netherita",
  "quest.43EDB52C38E79855.quest_subtitle": "&7Encuéntrala en un &dbastión&7 de las zonas del Nether de Yoth.",
  "quest.43EDB52C38E79855.quest_desc": [
    "&7Encuéntrala en un &dbastión&7 de las zonas del Nether de Yoth.",
    "",
    "&7Las zonas del Nether (bosques carmesí y distorsionado, ríos de lava, incursiones demoníacas) tienen &dbastiones&7. La plantilla está en sus cofres.",
    "&cLos piglins te atacan si no llevas oro puesto&7: ponte unas botas de oro.",
    "&7Para copiarla: la plantilla, &d7 diamantes&7 y &d1 netherrack&7."
  ],
  "quest.471327BBFCAF11E0.title": "&8Primera pieza de netherita",
  "quest.471327BBFCAF11E0.quest_subtitle": "&7Mejora una herramienta o una pieza de armadura de &ddiamante&7 a &dnetherita&7.",
  "quest.471327BBFCAF11E0.quest_desc": [
    "&7Mejora una herramienta o una pieza de armadura de &ddiamante&7 a &dnetherita&7.",
    "",
    "&7En la &dmesa de herrería&7: la plantilla, la pieza de diamante y un lingote de netherita.",
    "&cLa plantilla se gasta&7: cópiala antes de usarla."
  ],
  "quest.465AADD25710CEE9.title": "&5&lCubierto de netherita",
  "quest.465AADD25710CEE9.quest_subtitle": "&7Lleva la &darmadura de netherita completa&7.",
  "quest.465AADD25710CEE9.quest_desc": [
    "&7Lleva la &darmadura de netherita completa&7.",
    "",
    "&7Ya estás listo para el mundo normal: todo lo que llevas &dviaja contigo&7.",
    "&7Siguiente paso: la &dNetherita avanzada&7, en el grupo &f&lEquipo&r&7."
  ],
  "quest.447B564C35375558.title": "&aVía rápida de Yoth",
  "quest.447B564C35375558.quest_subtitle": "&7De cero a netherita en el mundo amable.",
  "quest.447B564C35375558.quest_desc": [
    "&7De cero a netherita en el mundo amable."
  ],
  "task.4666D3CD34F65F48.title": "&7Fabrica un pico de piedra en Yoth",
  "task.4830FF6609B34E86.title": "&7Funde o recoge 8 lingotes de hierro en Yoth",
  "task.4520D768EBE06E2B.title": "&7Fabrica un pico de hierro en Yoth",
  "task.4ABE7E6118DC8E62.title": "&7Recoge 3 diamantes en Yoth",
  "task.42A94609EDB05FAE.title": "&7Fabrica un pico de diamante en Yoth",
  "task.4773B30C77045867.title": "&7Pica 4 escombros ancestrales en Yoth",
  "task.44DA7E1F749A3ECC.title": "&7Funde o recoge 4 lingotes de oro en Yoth",
  "task.496F1780B1F3FA58.title": "&7Fabrica un lingote de netherita en Yoth",
  "task.425D4EB0D424D92D.title": "&7Consigue una plantilla de mejora de netherita en Yoth",
  "task.44FC087FC58F9A8D.title": "&7Mejora una pieza a netherita en Yoth",
  "task.46891C307E0C133A.title": "&7Lleva la armadura de netherita completa en Yoth"
