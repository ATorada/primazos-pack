  "quest.49F3FDB4BB632ADC.quest_subtitle": "&7Qué hacer en cada fase de la partida para no ir perdido.",
  "quest.49F3FDB4BB632ADC.quest_desc": [
    "&7Qué hacer en cada fase de la partida para no ir perdido."
  ],
