  ],
  "chapter.4B2E7C91D05A3F68.title": "&7› &6Caballos",
  "quest.41D8E3A72C5B96F0.title": "&eTu caballo",
  "quest.41D8E3A72C5B96F0.quest_subtitle": "&7Doma un caballo y pasa a ser tuyo.",
  "quest.41D8E3A72C5B96F0.quest_desc": [
    "&7Cuando terminas de domar un caballo queda &aregistrado a tu nombre&7.",
    "&7Solo tú puedes llevarlo: si otro jugador intenta montarlo como jinete principal, &cel caballo lo tira&7. Sí acepta un segundo jinete detrás.",
    "",
    "&7Para dejar que un amigo lo monte solo:",
    "&e/horse trust Nombre&7 (vale para todos tus caballos)",
    "&e/horse untrust Nombre&7 para quitárselo y &e/horse trusted&7 para ver la lista."
  ],
  "quest.47B05C1E9A3D2864.title": "&eSilbato y órdenes",
  "quest.47B05C1E9A3D2864.quest_subtitle": "&7Llama a tu caballo y dale órdenes con la rueda.",
  "quest.47B05C1E9A3D2864.quest_desc": [
    "&e&lSilbato / Info&r&7 (botón lateral del ratón): los caballos cercanos te siguen y los lejanos se acercan. Montado, abre la ficha del caballo.",
    "&e&lRueda de órdenes&r&7 (rueda del ratón): mira a tu caballo y elige una orden.",
    "&e&lGestionar caballos&r&7 (&f]&7): lista de todos tus caballos.",
    "&e&lCarga&r&7 (Alt derecho): el caballo embiste a lo que tengas delante.",
    "&e&lMirar libre&r&7 (mantén Ctrl izquierdo montado): giras la cámara sin girar al caballo.",
    "",
    "&7Puedes cambiar las teclas en Opciones > Controles > Icy's Better Horses."
  ],
  "quest.4C6A91F3E07D5B28.title": "&eRazas y clases",
  "quest.4C6A91F3E07D5B28.quest_subtitle": "&715 razas repartidas en 5 clases.",
  "quest.4C6A91F3E07D5B28.quest_desc": [
    "&7Hay &e15 razas&7 con pelajes y biomas propios, en cinco clases:",
    "&6Carreras&7 (Pura sangre, Árabe...): las más rápidas.",
    "&cGuerra&7 (Frisón, Andaluz...): aguantan y embisten.",
    "&8Tiro&7 (Percherón, Shire, Clydesdale, Belga): fuertes y los únicos que tiran del &ecarro grande&7.",
    "&aPonis&7 (Islandés, Haflinger): pequeños y ágiles.",
    "&eWestern&7 (Mustang, Quarter, Paint, Appaloosa, Morgan): equilibrados.",
    "",
    "&7Al criar razas distintas sale un &dmestizo&7."
  ],
  "quest.42F7D08B6E1C3A95.title": "&eSilla mejorada",
  "quest.42F7D08B6E1C3A95.quest_subtitle": "&7La base de todo el equipo del caballo.",
  "quest.42F7D08B6E1C3A95.quest_desc": [
    "&7Se hace con una &fsilla&7 normal, &6cobre&7 y unos &bdiamantes&7.",
    "&7Desbloquea las &eranuras de equipo&7 del caballo y, al llevarla en la mano, te enseña sus estadísticas."
  ],
  "quest.4D3B5E92A70C6F14.title": "&eHerraduras",
  "quest.4D3B5E92A70C6F14.quest_subtitle": "&7Pisada firme en terreno difícil.",
  "quest.4D3B5E92A70C6F14.quest_desc": [
    "&7Lingotes de &6cobre&7 y una tira de cuero.",
    "&7El caballo puede andar sobre &fnieve en polvo&7 y recibe &amenos daño de caída&7."
  ],
  "quest.48E2C6A0F5913B7D.title": "&eBotiquín",
  "quest.48E2C6A0F5913B7D.quest_subtitle": "&7Cura a tu caballo cuando está en apuros.",
  "quest.48E2C6A0F5913B7D.quest_desc": [
    "&7Lana, material de curación y una &dpoción de regeneración&7.",
    "&7Cuando el caballo baja de &cla mitad de vida&7 lo cura automáticamente."
  ],
  "quest.43A9F1D75C08E26B.title": "&eArnés Alaplaneo",
  "quest.43A9F1D75C08E26B.quest_subtitle": "&7Frena las caídas grandes.",
  "quest.43A9F1D75C08E26B.quest_desc": [
    "&7Se monta sobre la &esilla mejorada&7 y se fabrica con &6cápsulas&7 (cobre y oro).",
    "&7Frena las caídas grandes y puede &aanular el daño de caída&7.",
    "&7Cuando se gasta, recárgalo en un &fyunque&7 con otra cápsula."
  ],
  "quest.4F05B8C3D2A6971E.title": "&eCarro",
  "quest.4F05B8C3D2A6971E.quest_subtitle": "&7Lleva pasajeros, un cofre o un arado.",
  "quest.4F05B8C3D2A6971E.quest_desc": [
    "&7Dos &eruedas&7 (palos y tablones), una fila de tablones y dos losas encima.",
    "&7El caballo tira de él y puede llevar &fpasajeros&7, un &6cofre&7 o un &aarado&7. Ábrelo con &eAlt izquierdo&7.",
    "&7El &ecarro grande&7 solo lo pueden mover los caballos de &8tiro&7."
  ],
  "quest.4917D4E0B8C25A3F.title": "&eManual del Establo",
  "quest.4917D4E0B8C25A3F.quest_subtitle": "&7El libro guía del mod.",
  "quest.4917D4E0B8C25A3F.quest_desc": [
    "&7Junta cualquier objeto de Better Horses con un &flibro&7 y tendrás el &6Manual del Establo&7.",
    "&7Explica todo con detalle: razas, pelajes, equipo y recetas."
  ],
  "quest.4E61A0C7B93D2F15.title": "&6Icy's Better Horses",
  "quest.4E61A0C7B93D2F15.quest_subtitle": "&7Los caballos dejan de ser un medio de transporte de usar y tirar.",
  "quest.4E61A0C7B93D2F15.quest_desc": [
    "&7Los caballos pasan a ser &6compañeros para toda la partida&7: tienen dueño, se vinculan contigo, hay &e15 razas&7 con sus propios pelajes y biomas, equipo propio y &ecarros&7.",
    "",
    "&7Todo el mod viene explicado en su libro guía, el &6Manual del Establo&7."
  ],
  "chapter.459A2F7493AAA428.title": "&6Hogar y creatividad",
  "quest.46D6099044CD1A79.title": "&6MrCrayfish's Furniture: Refurbished",
  "quest.46D6099044CD1A79.quest_subtitle": "&7Cientos de muebles: cocinas, sofás, lámparas, televisores,…",
