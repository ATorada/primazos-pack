  "chapter.4DB240077E0917AE.title": "&bÉgida de Protección",
  "quest.4A7ECEFFB1CE929A.title": "&a&lÉgida&r&7",
  "quest.4A7ECEFFB1CE929A.quest_subtitle": "Si mueres varias veces seguidas.",
  "quest.4A7ECEFFB1CE929A.quest_desc": [
    "Al reaparecer, la &a&lÉgida&r&7 te cubre durante &d15 minutos&7:",
    "&aRapidez, Regeneración y Fuerza&7",
    "Cuantas más muertes seguidas (hasta 5), más fuerte.",
    "",
    "&eBajo el agua, además: &bApnea y Visión nocturna&7",
    "",
    "&eProbabilidad de un &dTÓTEM&7&e:",
    "&71: &f5%&7 · 2: &f10%&7 · 3: &f15%&7 · 4: &f25%&7 · 5: &650%",
    "",
    "&8No se activa si te mata otro jugador."
  ],
  "quest.4676ADFB8603167E.title": "&6Spawners Cegados",
  "quest.4676ADFB8603167E.quest_subtitle": "Los spawners sacan menos monstruos.",
  "quest.4676ADFB8603167E.quest_desc": [
    "Los rayos del &e&lSol&r&7 ciegan los spawners: sacan muchos menos monstruos de lo normal.",
    "",
    "&8Monumentos, torres y spawners de prueba."
  ],
  "quest.4BD515C40CD0CD0C.title": "&bEvaporación Instantánea",
  "quest.4BD515C40CD0CD0C.quest_subtitle": "Menos guardianes.",
  "quest.4BD515C40CD0CD0C.quest_desc": [
    "Si los guardianes se pasan de mitosis (más de 20), el &e&lSol&r&7 evapora a la &dMITAD&7 sin dejar rastro."
  ],
  "quest.4C43DF55E70F0A48.title": "&6Cohete Perdido",
  "quest.4C43DF55E70F0A48.quest_subtitle": "20% de que un cohete se deshaga.",
  "quest.4C43DF55E70F0A48.quest_desc": [
    "Cada cohete que dispara un saqueador tiene un &d20%&7 de deshacerse en humo antes de llegar a ti."
  ],
  "quest.4E3055876B934EA9.title": "&eDeslumbramiento",
  "quest.4E3055876B934EA9.quest_subtitle": "25% de deslumbrar al illager.",
  "quest.4E3055876B934EA9.quest_desc": [
    "Cuando un vindicador, inquisidor o marauder te golpea, hay un &d25%&7 de que el &e&lSol&r&7 lo deslumbre:",
    "&c3 ❤ de daño&7",
    "&bDébil y casi congelado 10 segundos&7"
  ],
  "quest.4C84E15B6B2634F6.title": "&5Forja Bendecida",
  "quest.4C84E15B6B2634F6.quest_subtitle": "20% de un lingote extra.",
  "quest.4C84E15B6B2634F6.quest_desc": [
    "Al fabricar un lingote de netherita, hay un &d20%&7 de que el &e&lSol&r&7 te regale otro."
  ],
  "quest.4B16A06875A5D051.title": "&6Calor del Sol",
  "quest.4B16A06875A5D051.quest_subtitle": "20% de chatarra extra.",
  "quest.4B16A06875A5D051.quest_desc": [
    "Al sacar chatarra de netherita del horno, cada una tiene un &d20%&7 de darte otra más.",
    "",
    "&8Sacándola tú: con tolvas no cuenta."
  ],
  "quest.4480F963C9234B4A.title": "&5Plantilla Bendecida",
  "quest.4480F963C9234B4A.quest_subtitle": "25% de una plantilla extra.",
  "quest.4480F963C9234B4A.quest_desc": [
    "Al duplicar una plantilla de mejora de netherita, hay un &d25%&7 de que el &e&lSol&r&7 te dé una más."
  ],
  "quest.40D481890F723CF4.title": "&dBrebaje Roto",
  "quest.40D481890F723CF4.quest_subtitle": "25% de romper la poción de una bruja.",
  "quest.40D481890F723CF4.quest_desc": [
    "Cada poción que te lanza una bruja tiene un &d25%&7 de romperse en el aire."
  ],
  "quest.4B2CACA647FCCD72.title": "&bTridente Partido",
  "quest.4B2CACA647FCCD72.quest_subtitle": "20% de partir un tridente.",
  "quest.4B2CACA647FCCD72.quest_desc": [
    "Cada tridente que lanza un ahogado tiene un &d20%&7 de partirse en polvo de estrellas."
  ],
  "quest.44DF2E7F9D84C824.title": "&fFlecha Perdida",
  "quest.44DF2E7F9D84C824.quest_subtitle": "15% de perder una flecha.",
  "quest.44DF2E7F9D84C824.quest_desc": [
