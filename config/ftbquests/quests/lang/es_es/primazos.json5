  "quest.4EB01E40F3569BDA.title": "&2Wyvern de pantano",
  "quest.4EB01E40F3569BDA.quest_subtitle": "&7Dónde: pantanos.",
  "quest.4EB01E40F3569BDA.quest_desc": [
    "&bDónde: pantanos.",
    "&eDomarlo:",
    "&r&7Dale 1-2 stacks de &r&dpollo&r&7 (crudo o cocinado) o 4 stacks de cualquier otra carne (vale la carne podrida).",
    "&eObjetos:",
    "&r&dMontura&r&7 o &r&dMontura&r&7 &r&ddoble&r&7 (para ir dos). Con un &r&dfrasco&r&7 &r&dvacío&r&7 le sacas ácido, que se usa como una poción.",
    "&r&dNO&r&7 puede llevar armadura.",
    "&eHabilidades (G y R):",
    "&r&7Escupe bolas de &r&dácido&r&7 (puntería regular) y muerde."
  ],
  "quest.4028E6C369FD4CB0.title": "&eLightning Chaser",
  "quest.4028E6C369FD4CB0.quest_subtitle": "&7Dónde: aparece en las tormentas cerca de los jugadores.",
  "quest.4028E6C369FD4CB0.quest_desc": [
    "&bDónde: aparece en las tormentas cerca de los jugadores.",
    "&eDomarlo:",
    "&7Hay que vencerlo: bájale la vida y golpéalo con &r&d3&r&7 &r&drayos&r&7 (tridente con &r&dCanalización&r&7).",
    "&eObjetos:",
    "&r&dMontura&r&7, &r&darmadura&r&7 &r&dde&r&7 &r&ddragón (casco, peto y cola de hierro, oro, diamante o netherita) y estandartes.",
    "&eHabilidades (G y R):",
    "&r&dAliento&r&7 &r&dde&r&7 &r&drayo&r&7: rompe bloques y hace lo mismo que un rayo (creepers cargados, brujas...).",
    "&r&dOnda&r&7 &r&dexpansiva&r&7 (solo volando):",
    "&7desvía flechas y empuja a los mobs.",
    "&7En el suelo, muerde.",
    "&r&7Ambos ataques dan &r&dShock&r&7: el enemigo va más lento, pega menos y ve peor."
  ],
  "quest.4262A3CF669E9159.title": "&6Moleclaw",
  "quest.4262A3CF669E9159.quest_subtitle": "&7Dónde: cuevas.",
  "quest.4262A3CF669E9159.quest_desc": [
    "&bDónde: cuevas.",
    "&eDomarlo:",
    "&7Dale de media a una stack de remolacha&r&7.",
    "&eObjetos:",
    "&r&dMontura&r&7, &r&darmadura&r&7 &r&dde&r&7 &r&ddragón y su &r&dcasco&r&7 &r&dde&r&7 &r&dMoleclaw&r&7: sin el casco le da miedo la luz.",
    "&eHabilidades (G y R):",
    "&r&dExcava&r&7 lo que rompe un pico de madera. Con poción de &r&dFuerza&r&7 rompe bloques más duros; con &r&dDebilidad no rompe nada.",
    "&7Ataques cuerpo a cuerpo que dan a todo lo que tiene delante."
  ],
  "quest.4AA866B9AC7C316F.title": "&bRiver Pikehorn",
  "quest.4AA866B9AC7C316F.quest_subtitle": "&7Dónde: ríos y playas que no estén congelados.",
  "quest.4AA866B9AC7C316F.quest_desc": [
    "&bDónde: ríos y playas que no estén congelados.",
    "&eDomarlo:",
    "&r&7Un &r&dcubo&r&7 &r&dcon&r&7 &r&dpez&r&7 &r&dtropical&r&7 o 4-8 peces tropicales.",
    "&eObjetos:",
    "&r&7Con la &r&dFlauta&r&7 le mandas pescar para ti o atacar a un mob.",
    "&r&dNO&r&7 se monta: se lleva en la cabeza (agáchate y haz clic en un bloque para ponértelo o quitártelo).",
    "&eHabilidades:",
    "&7Solo ataca cuerpo a cuerpo."
  ],
  "quest.466A8F910111B077.title": "&cMagmamuncher",
  "quest.466A8F910111B077.quest_subtitle": "&7Dónde: Nether, cerca de los lagos de lava.",
  "quest.466A8F910111B077.quest_desc": [
    "&bDónde: Nether, cerca de los lagos de lava.",
    "&eDomarlo:",
    "&r&7Dale entre 4 y 12 &r&dvaras&r&7 &r&dde blaze&r&7.",
    "&eObjetos:",
    "&r&dNO&r&7 se monta: se lleva en la cabeza como el Pikehorn.",
    "&r&7Si lleva &r&dcombustible&r&7 en su inventario (carbón...), te da Resistencia&r&7 &r&dal&r&7 &r&dfuego&r&7 cuando te prendes.",
    "&eHabilidades:",
    "&7Excava bloques de magma (a veces saca carbón). Sus mordiscos queman y es inmune al fuego."
  ],
  "quest.4F3998BAF5DA2293.title": "&eÓrdenes y cuidados",
  "quest.4F3998BAF5DA2293.quest_subtitle": "&7Sirve para todos los dragones domados:",
  "quest.4F3998BAF5DA2293.quest_desc": [
    "&7Sirve para todos los dragones domados:",
    "",
    "&r&dAgáchate&r&7 &r&d+&r&7 &r&dclic&r&7 &r&dderecho&r&7:",
    "&7abrir su inventario y darle órdenes (seguir, quedarse, sentarse).",
    "&r&dPalo&r&7 o cuerno agachado: sentarlo o levantarlo.",
    "&7Pociones agachado: dárselas al dragón.",
    "&7Si le pones comida en el inventario, come solo."
  ],
  "quest.42CD36F88043CB23.title": "&bArmadura de dragón",
  "quest.42CD36F88043CB23.quest_subtitle": "&7Casco, peto y cola de hierro, oro, diamante o netherita (la de…",
  "quest.42CD36F88043CB23.quest_desc": [
    "&7Casco, peto y cola de hierro, oro, diamante o netherita (la de netherita, en la mesa de herrería).",
    "",
    "&r&7Solo para el &r&dLightning&r&7 &r&dChaser&r&7 y el &r&dMoleclaw&r&7."
  ],
  "quest.47518FCD7A890C0F.title": "&7Casco de Moleclaw",
  "quest.47518FCD7A890C0F.quest_subtitle": "&7Hace que el Moleclaw no tenga miedo de la luz.",
  "quest.47518FCD7A890C0F.quest_desc": [
    "&7Hace que el Moleclaw no tenga miedo de la luz."
  ],
  "quest.4E656E9748B1534E.title": "&6Montura doble",
  "quest.4E656E9748B1534E.quest_subtitle": "&7Solo para el Wyvern: para montar dos jugadores a la vez.",
  "quest.4E656E9748B1534E.quest_desc": [
    "&7Solo para el Wyvern: para montar dos jugadores a la vez."
  ],
  "quest.41A856F95FB3CC76.title": "&eFlauta",
  "quest.41A856F95FB3CC76.quest_subtitle": "&7Da órdenes a distancia: llamar, sentarse, levantarse, atacar o pescar.",
  "quest.41A856F95FB3CC76.quest_desc": [
    "&7Da órdenes a distancia: llamar, sentarse, levantarse, atacar o pescar.",
    "",
    "&r&dAgachado&r&7 &r&d+&r&7 &r&dclic&r&7 &r&dderecho&r&7 &r&dal aire&r&7: cambiar de orden.",
    "&r&dClic&r&7 &r&dderecho&r&7 &r&den&r&7 &r&dun&r&7 &r&ddragón&r&7:",
    "&7elegir a qué tipo de dragón mandas."
  ],
  "quest.479914831587CC98.title": "&dCuerno del vórtice",
  "quest.479914831587CC98.quest_subtitle": "&7Cuerno de cabra mejorado que GUARDA a tus dragones dentro para…",
  "quest.479914831587CC98.quest_desc": [
    "&7Cuerno de cabra mejorado que GUARDA&r&7 a tus dragones dentro para llevarlos contigo.",
    "",
    "&7Hay versiones de hierro, oro, diamante y netherita: cuanto mejor, más dragones caben."
  ],
  "quest.473E7C48EF200BEC.title": "&6Llamar a tu dragón",
  "quest.473E7C48EF200BEC.quest_subtitle": "&7Haz clic derecho con un cuerno de cabra sobre tu dragón para…",
  "quest.473E7C48EF200BEC.quest_desc": [
    "&r&7Haz clic derecho con un &r&dcuerno de&r&7 &r&dcabra&r&7 sobre tu dragón para vincularlo.",
    "",
    "&7Al tocar ese cuerno, el dragón vendrá aunque esté sentado."
  ],
  "quest.455D7936C805FA99.title": "&2Piel de wyvern",
  "quest.455D7936C805FA99.quest_subtitle": "&7Solo sirve para sacar 2 de cuero.",
  "quest.455D7936C805FA99.quest_desc": [
    "&7Solo sirve para sacar 2 de cuero."
  ],
  "quest.42C5627372EC7267.title": "&6Controles al montar",
  "quest.42C5627372EC7267.quest_subtitle": "&7W/S mover · Ctrl bajar",
  "quest.42C5627372EC7267.quest_desc": [
    "&r&dW/S&r&7 mover · &r&dCtrl&r&7 bajar",
    "&r&dG&r&7 y &r&dR&r&7 habilidades · &r&dZ&r&7 mirar libre",
    "",
    "&7Los dragones no se mueven de lado.",
    "&7Las teclas se cambian en Opciones > Controles."
  ],
