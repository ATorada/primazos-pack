  "quest.4F47932405EE7D6D.title": "&2Infusión de Vida No-Muerta",
  "quest.4F47932405EE7D6D.quest_subtitle": "20% de dañar al zombi que te pega.",
  "quest.4F47932405EE7D6D.quest_desc": [
    "Cuando un zombi te golpea, hay un &d20%&7 de que reciba:",
    "&cCuración instantánea: 3 ❤ de daño&7",
    "&bLentitud VI durante 5 segundos&7"
  ],
  "quest.42B3A405FBB94B9F.title": "&dRefundición Estelar",
  "quest.42B3A405FBB94B9F.quest_subtitle": "10% de reparar una pieza cada 5 min.",
  "quest.42B3A405FBB94B9F.quest_desc": [
    "Cada 5 minutos al aire libre de noche, hay un &d10%&7 de que las &d&lEstrellas&r&7 reparen &dPOR COMPLETO&7 una pieza gastada.",
    "",
    "&8Bajo techo o en cuevas no te ven."
  ],
  "quest.43D07842A1056114.title": "&dConstelación",
  "quest.43D07842A1056114.quest_subtitle": "Más experiencia en grupo.",
  "quest.43D07842A1056114.quest_desc": [
    "Las &d&lEstrellas&r&7 son más bonitas en compañía. De noche, a 32 bloques o menos:",
    "&73 jugadores: &f+25%",
    "&74 o más: &6+50%",
    "",
    "&8Lo verás arriba de la pantalla."
  ],
  "quest.48352B8BC49CB196.title": "&e&lProtección Solar",
  "quest.48352B8BC49CB196.quest_subtitle": "El &e&lSol&r&7&r os protege de los excesos.",
  "quest.48352B8BC49CB196.quest_desc": [
    "El &e&lSol&r&7 es un dios benevolente que vela por los jugadores de Primazos.",
    "",
    "Estas son sus bendiciones."
  ],
  "quest.43EDB872081104E2.title": "&d&lProtección de las Estrellas",
  "quest.43EDB872081104E2.quest_subtitle": "Las &d&lEstrellas&r&7&r guían a quien camina en la oscuridad.",
  "quest.43EDB872081104E2.quest_desc": [
    "Las &d&lEstrellas&r&7 son un dios benevolente. No dan poder: dan guía, para que las noches difíciles sean un poco más fáciles.",
    "",
    "&fSolo actúan de noche (desde que anochece) o en tormenta."
  ],
  "quest.42283FA0885C276E.title": "&a&lÉgida de Protección",
  "quest.42283FA0885C276E.quest_subtitle": "Dos dioses benevolentes velan por Primazos.",
  "quest.42283FA0885C276E.quest_desc": [
    "El &e&lSol&r&7 de día y las &d&lEstrellas&r&7 de noche.",
    "",
    "Y cuando todo sale mal, la &a&lÉgida&r&7 te cubre."
  ],
  "chapter.49245C1C892580C8.title": "&bMonstruos que escalan",
