  "quest.4E408B3913B22C58.quest_desc": [
    "&7Falling leaves, wind, revamped clouds and small visual touches."
  ],
  "quest.4B00C3C73E192134.title": "&fZoomify",
  "quest.4B00C3C73E192134.quest_subtitle": "&7Zoom with the C key.",
  "quest.4B00C3C73E192134.quest_desc": [
    "&7Zoom with the C key."
  ],
  "quest.460DFE73E9301888.title": "&7Controlify",
  "quest.460DFE73E9301888.quest_subtitle": "&7You can play with a controller.",
  "quest.460DFE73E9301888.quest_desc": [
    "&7You can play with a controller."
  ],
  "quest.4F1BA84280C4B810.title": "&cPerformance",
  "quest.4F1BA84280C4B810.quest_subtitle": "&7Sodium, Lithium, FerriteCore and others make the game run much…",
  "quest.4F1BA84280C4B810.quest_desc": [
    "&7Sodium, Lithium, FerriteCore and others make the game run much smoother. If it's slow, lower shaders or render distance."
  ],
  "quest.45BA21F861210564.title": "&3Visuals, sound and performance",
  "quest.45BA21F861210564.quest_subtitle": "&7Shaders, realistic sounds, animations and mods that keep the game…",
  "quest.45BA21F861210564.quest_desc": [
    "&7Shaders, realistic sounds, animations and mods that keep the game running smoothly."
  ],
  "chapter.454FABAB4D9ED871.title": "&d&lYoth&r&7: fast track",
  "image.4E21C5C5F21BE88A.title": "&lGo to Yoth",
  "image.45FEB1981C1A8930.title": "&lGo back",
  "image.4A7D3E91C5B20F68.title": "&lGo to the Veil",
  "image.4F18B6C2D9A47E03.title": "&lGo back",
  "quest.4EACA8D62A63C301.title": "&dWhat is Yoth",
  "quest.4EACA8D62A63C301.quest_subtitle": "&7A &dfriendly&7 cave world to learn the ropes and reach &dnetherite&7 fast.",
  "quest.4EACA8D62A63C301.quest_desc": [
    "&7A &dfriendly&7 cave world to learn the ropes and reach &dnetherite&7 fast.",
    "",
    "&7There are &dvery few monsters&7 and almost everything from the normal world: villages, dungeons, every ore and Nether zones with &dbastions&7.",
    "&dAncient debris&7 spawns in &devery biome&7.",
    "",
    "&7The &dscaling monsters&7 don't count here: your level &dneither goes up nor down&7.",
    "&7Whatever you get in Yoth &dcomes with you&7 to the normal world, and the other way round.",
    "",
    "&cBeds don't set your respawn point&7: if you die, you wake up in your bed in the normal world and your grave stays in Yoth.",
    "",
    "&7This chapter &donly moves forward with what you get inside Yoth&7: crafting, smelting, mining or picking up. Anything brought from outside doesn't count.",
    "",
    "&7When you enter you wear the &dYoth lantern&7: monsters leave you alone."
  ],
  "quest.4B8C3DC2448B1B41.title": "&d&lEnter Yoth",
  "quest.4B8C3DC2448B1B41.quest_subtitle": "&7Press &e&lGo to Yoth&r&7 (below) and walk through the portal.",
  "quest.4B8C3DC2448B1B41.quest_desc": [
    "&7Press &e&lGo to Yoth&r&7 (below) and walk through the portal.",
    "",
    "&e&lGo to Yoth&r&7: a &dportal&7 opens in front of you. It's ready in 2 seconds: &dwalk through it&7.",
    "&e&lGo back&r&7: the same from Yoth, and you appear &dwhere you were&7.",
    "",
    "&7Also with &e&l/trigger yoth set 1&r&7 (go) and &e&l/trigger yoth set 2&r&7 (back).",
    "&cIt can't be opened in the middle of a fight&7.",
    "",
    "&7The first time you arrive above where you were; after that, at your &dlast safe spot&7 in Yoth.",
    "",
    "&7The portal always drops you in a &dsafe spot&7 and you get a few seconds of &dfull protection&7 on arrival."
  ],
  "quest.46090082BF3B0803.title": "&fStone and wood",
  "quest.46090082BF3B0803.quest_subtitle": "&7Craft a &dstone pickaxe&7.",
  "quest.46090082BF3B0803.quest_desc": [
    "&7Craft a &dstone pickaxe&7.",
    "",
    "&7There's no sun in Yoth: carry &dtorches&7 and don't wander off without light."
  ],
  "quest.4F06056A7B906436.title": "&fIron",
  "quest.4F06056A7B906436.quest_subtitle": "&7Gather &d8 iron ingots&7.",
  "quest.4F06056A7B906436.quest_desc": [
    "&7Gather &d8 iron ingots&7.",
    "",
    "&7It's everywhere on cave walls. Smelt it in a furnace."
  ],
  "quest.4736B846400EFFE0.title": "&fIron pickaxe",
  "quest.4736B846400EFFE0.quest_subtitle": "&7Craft an &diron pickaxe&7: now you can mine &ddiamond&7 and &dgold&7.",
  "quest.4736B846400EFFE0.quest_desc": [
    "&7Craft an &diron pickaxe&7: now you can mine &ddiamond&7 and &dgold&7."
  ],
  "quest.4FE98792CFBB4DDF.title": "&dThe Yoth lantern",
  "quest.4FE98792CFBB4DDF.quest_subtitle": "&7In Yoth you always wear an &damethyst lantern&7 on your belt.",
  "quest.4FE98792CFBB4DDF.quest_desc": [
    "&7In Yoth you always wear an &damethyst lantern&7 on your belt.",
    "",
    "&7It's put on when you enter, &dcan't be taken off&7 and disappears when you leave or die.",
    "&7- Nearby monsters &dstep away&7 and don't chase you.",
    "&7- If you &chit one&7, that monster fights back for 15 seconds.",
    "&7- &dFewer monsters&7 spawn around you.",
    "&7- &cBosses&7 ignore it."
  ],
  "quest.49FFC7CD9BC37E56.title": "&bDiamonds",
  "quest.49FFC7CD9BC37E56.quest_subtitle": "&7Get &d3 diamonds&7.",
  "quest.49FFC7CD9BC37E56.quest_desc": [
    "&7Get &d3 diamonds&7.",
    "",
    "&7They're at the very bottom, below layer 0. Explore big caves or branch mine."
  ],
  "quest.4C14BA8F7DC2A3C1.title": "&bDiamond pickaxe",
  "quest.4C14BA8F7DC2A3C1.quest_subtitle": "&7Craft a &ddiamond pickaxe&7: the only one that mines &dancient debris&7.",
  "quest.4C14BA8F7DC2A3C1.quest_desc": [
    "&7Craft a &ddiamond pickaxe&7: the only one that mines &dancient debris&7."
  ],
  "quest.4045D997AE397EB5.title": "&6Ancient debris",
  "quest.4045D997AE397EB5.quest_subtitle": "&7Get &d4 ancient debris&7.",
  "quest.4045D997AE397EB5.quest_desc": [
    "&7Get &d4 ancient debris&7.",
    "",
    "&7In Yoth it spawns in &devery biome&7, from the bottom up to layer 140, with bigger veins &dbelow layer 30&7.",
    "&7It looks like brown stone with swirls and survives explosions.",
    "&7Smelt it in a furnace: each one gives a &dnetherite scrap&7."
  ],
  "quest.426B306E73BE5A5D.title": "&eGold",
  "quest.426B306E73BE5A5D.quest_subtitle": "&7Gather &d4 gold ingots&7.",
  "quest.426B306E73BE5A5D.quest_desc": [
    "&7Gather &d4 gold ingots&7.",
    "",
    "&d4 netherite scraps&7 and &d4 gold ingots&7 make a netherite ingot."
  ],
  "quest.468315DA3D9135C1.title": "&8Netherite ingot",
  "quest.468315DA3D9135C1.quest_subtitle": "&7Craft a &dnetherite ingot&7.",
  "quest.468315DA3D9135C1.quest_desc": [
    "&7Craft a &dnetherite ingot&7.",
    "",
    "&7At the crafting table: 4 netherite scraps and 4 gold ingots, in any order."
  ],
  "quest.43EDB52C38E79855.title": "&dNetherite upgrade template",
  "quest.43EDB52C38E79855.quest_subtitle": "&7Find it in a &dbastion&7 in Yoth's Nether zones.",
  "quest.43EDB52C38E79855.quest_desc": [
    "&7Find it in a &dbastion&7 in Yoth's Nether zones.",
    "",
    "&7The Nether zones (crimson and warped forests, lava rivers, demonic incursions) have &dbastions&7. The template is in their chests.",
    "&cPiglins attack you unless you wear gold&7: put on some gold boots.",
    "&7To copy it: the template, &d7 diamonds&7 and &d1 netherrack&7."
  ],
  "quest.471327BBFCAF11E0.title": "&8First netherite piece",
  "quest.471327BBFCAF11E0.quest_subtitle": "&7Upgrade a &ddiamond&7 tool or armor piece to &dnetherite&7.",
  "quest.471327BBFCAF11E0.quest_desc": [
    "&7Upgrade a &ddiamond&7 tool or armor piece to &dnetherite&7.",
    "",
    "&7At the &dsmithing table&7: the template, the diamond piece and a netherite ingot.",
    "&cThe template is used up&7: copy it first."
  ],
  "quest.465AADD25710CEE9.title": "&5&lCovered in netherite",
  "quest.465AADD25710CEE9.quest_subtitle": "&7Wear the &dfull netherite armor&7.",
  "quest.465AADD25710CEE9.quest_desc": [
    "&7Wear the &dfull netherite armor&7.",
    "",
    "&7You're ready for the normal world: everything you carry &dcomes with you&7.",
    "&7Next step: &dAdvanced Netherite&7, in the &f&lGear&r&7 group."
  ],
  "quest.447B564C35375558.title": "&aYoth fast track",
  "quest.447B564C35375558.quest_subtitle": "&7From zero to netherite in the friendly world.",
  "quest.447B564C35375558.quest_desc": [
    "&7From zero to netherite in the friendly world."
  ],
  "task.4666D3CD34F65F48.title": "&7Craft a stone pickaxe in Yoth",
  "task.4830FF6609B34E86.title": "&7Smelt or pick up 8 iron ingots in Yoth",
  "task.4520D768EBE06E2B.title": "&7Craft an iron pickaxe in Yoth",
  "task.4ABE7E6118DC8E62.title": "&7Pick up 3 diamonds in Yoth",
  "task.42A94609EDB05FAE.title": "&7Craft a diamond pickaxe in Yoth",
  "task.4773B30C77045867.title": "&7Mine 4 ancient debris in Yoth",
  "task.44DA7E1F749A3ECC.title": "&7Smelt or pick up 4 gold ingots in Yoth",
  "task.496F1780B1F3FA58.title": "&7Craft a netherite ingot in Yoth",
  "task.425D4EB0D424D92D.title": "&7Get a netherite upgrade template in Yoth",
  "task.44FC087FC58F9A8D.title": "&7Upgrade a piece to netherite in Yoth",
  "task.46891C307E0C133A.title": "&7Wear the full netherite armor in Yoth"
}
