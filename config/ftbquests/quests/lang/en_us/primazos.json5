  "quest.4E7A2C95B1D83F40.title": "&dDiferent Levels &7- Gambol88",
  "quest.4E7A2C95B1D83F40.quest_subtitle": "&7Yoth's soundtrack, on a disc.",
  "quest.4E7A2C95B1D83F40.quest_desc": [
    "&7Claim the &d&lYoth&r&7 disc (&eDiferent Levels&7) to play it in a jukebox.",
    "",
    "&7You can claim it again every &d10 minutes&7 and it gives a little experience."
  ],
  "quest.4227C911EB0F1706.title": "&eHow to read this book",
  "quest.4227C911EB0F1706.quest_subtitle": "What each shape and each colour means.",
  "quest.4227C911EB0F1706.quest_desc": [
    "&fCircle&7: a step in your adventure. It completes on its own when you get it and gives &6rewards&7.",
    "&fDiamond&7: a boss.",
    "&fHexagon&7: how the server works.",
    "&fSquare&7: information.",
    "&fNut&7: a section summary. When it shows the &e&l!&r&7, open it and collect your &6experience&7.",
    "",
    "&dKeywords&7 are in pink, &cdangers&7 in red and &6rewards&7 in gold."
  ],
  "quest.464931B3842EB6E2.title": "&eHow to open the book",
  "quest.464931B3842EB6E2.quest_subtitle": "Progress button, the book or a command.",
  "quest.464931B3842EB6E2.quest_desc": [
    "Press &e&lEsc&r&7 and the &6Progress&7 button.",
    "",
    "When you join we give you the &6Primazos Atlas&7: right-click with it.",
    "",
    "Also: &e&l/ftbquests open_book&r&7, or bind a key in Options → Controls → FTB Quests."
  ],
  "quest.4CA0580DF13FA630.title": "&a&lAdventure",
  "quest.4CA0580DF13FA630.quest_subtitle": "What to do now. Progress step by step.",
  "quest.4CA0580DF13FA630.quest_desc": [
    "The zone with &dprogress&7: each step completes on its own when you achieve it and gives &6rewards&7.",
    "",
    "First days → The World → The Nether → The End → The Sift."
  ],
  "quest.44EFBB7B0E4010DF.title": "&f&lGear",
  "quest.44EFBB7B0E4010DF.quest_subtitle": "Armor, weapons and enchantments.",
  "quest.44EFBB7B0E4010DF.quest_desc": [
