  "quest.422716798758A90C.title": "&5End Veil",
  "quest.422716798758A90C.quest_subtitle": "&7You can look at Endermen without angering them.",
  "quest.422716798758A90C.quest_desc": [
    "&7You can look at Endermen without angering them.",
    "",
    "&eWhere:",
    "&r&fIt's a &r&dPOTION&r&f: awkward potion + End dust in the brewing stand.",
    "",
    "&8BetterEnd"
  ],
  "quest.4E2073747FFA4AD8.title": "&dMod enchantments",
  "quest.4E2073747FFA4AD8.quest_subtitle": "&7The new enchantments added by the mods and what they do.",
  "quest.4E2073747FFA4AD8.quest_desc": [
    "&7The new enchantments added by the mods and what they do."
  ],
  "quest.4FB49D9479A7979C.title": "&eTips",
  "quest.4FB49D9479A7979C.quest_subtitle": "&7Easy Magic: the table keeps your items and lapis lazuli.",
  "quest.4FB49D9479A7979C.quest_desc": [
    "&7Easy Magic: the table keeps your items and lapis lazuli.",
    "&7Easy Anvils: the anvil costs fewer levels.",
    "&7Gold netherite (Advanced Netherite) gives better enchantments.",
    "&7The Imbuing Table (Illager Invasion)",
    "&7pushes enchantments above their max level."
  ],
  "chapter.4C8D0CBF387CF035.title": "&eRecommended route",
  "quest.4F77C40DB519E79B.title": "&fPhase 1: Survive",
  "quest.4F77C40DB519E79B.quest_subtitle": "&7Stone tools, food, a bed and a base. Craft a backpack…",
  "quest.4F77C40DB519E79B.quest_desc": [
    "&7Stone tools, food, a bed and a base. Craft a backpack and a calendar."
  ],
  "quest.4D8431B3AF6BB688.title": "&fPhase 2: Iron and exploring",
  "quest.4D8431B3AF6BB688.quest_subtitle": "&7Iron armor and shield. Explore easy structures and look for eyes…",
  "quest.4D8431B3AF6BB688.quest_desc": [
    "&7Iron armor and shield. Explore easy structures and start looking for End eyes now."
  ],
  "quest.4667020EDA4B9FE1.title": "&bPhase 3: Diamond and Nether",
  "quest.4667020EDA4B9FE1.quest_subtitle": "&7Go to the Nether with diamond and a gold piece. Nether fortresses and…",
  "quest.4667020EDA4B9FE1.quest_desc": [
    "&7Go to the Nether with diamond and a gold piece. Nether fortresses and villages are among the most dangerous places. BetterNether gives you cincinnasite and rubies."
  ],
  "quest.4596518D509AC349.title": "&8Phase 4: Netherite",
  "quest.4596518D509AC349.quest_subtitle": "&7Look for ancient debris and upgrade everything to netherite. Enchant your…",
  "quest.4596518D509AC349.quest_desc": [
    "&7Look for ancient debris and upgrade everything to netherite. Enchant your gear well."
  ],
  "quest.41EF52622DC8DDF7.title": "&bPhase 5: Advanced netherite",
  "quest.41EF52622DC8DDF7.quest_subtitle": "&7Upgrade to iron, gold, emerald and finally diamond netherite…",
  "quest.41EF52622DC8DDF7.quest_desc": [
    "&7Upgrade to iron, gold, emerald and finally diamond netherite (26 defense). Later on there are two more upgrades: aeternium and siftite."
  ],
  "quest.496AF721CFBDE226.title": "&3Phase 6: Open the End",
  "quest.496AF721CFBDE226.quest_subtitle": "&7Gather the special eyes from End Remastered and get ready for the…",
  "quest.496AF721CFBDE226.quest_desc": [
    "&7Gather the special eyes from End Remastered and get ready for the remastered Ender Dragon. Better in a group."
  ],
  "quest.4DFD392D27514515.title": "&5Phase 7: The real End",
  "quest.4DFD392D27514515.quest_subtitle": "&7Explore BetterEnd: terminite, crystalite and aeternium. With 4 ingots…",
  "quest.4DFD392D27514515.quest_desc": [
    "&7Explore BetterEnd: terminite, crystalite and aeternium. With 4 aeternium ingots and a netherite and diamond ingot you make netherite and aeternium (defense 28, and shulkers no longer lift you). The End cities and the elytra."
  ],
  "quest.4C5C2202670202A5.title": "&3Phase 8: The Sift and bosses",
  "quest.4C5C2202670202A5.quest_subtitle": "&7With all of the above, explore The Sift, the bosses and the hardest…",
  "quest.4C5C2202670202A5.quest_desc": [
    "&7With all of the above, explore The Sift, the bosses and the hardest dungeons.",
    "",
    "&7The Sift has no dungeons: with 4 siftite ingots and an aeternium-netherite ingot you make siftite-netherite, the best gear in the modpack (30 defense, resists darkness). The Sifter hits like an elite mob."
  ],
  "quest.49F3FDB4BB632ADC.title": "&aRecommended route",
  "quest.49F3FDB4BB632ADC.quest_subtitle": "&7What to do at each stage of the game so you don't get lost.",
  "quest.49F3FDB4BB632ADC.quest_desc": [
    "&7What to do at each stage of the game so you don't get lost."
  ],
  "chapter.48116F9F4DFBB1BA.title": "&7› &2Route: the Veil",
  "quest.47C1575671C9D30E.title": "&e&lPhase 9: Aerial Hell and the Broken Veil",
  "quest.47C1575671C9D30E.quest_subtitle": "&7When the Veil weakens, climb to the roof of the world and cross it.",
  "quest.47C1575671C9D30E.quest_desc": [
    "&r&7When the &r&e&lVeil&r&7 weakens, climb to the roof of the world and cross.",
    "&r&7Defeat the &r&d4 divine echoes&r&7 and forge the &r&aBroken Veil armor&r&7."
  ],
  "quest.48767560B4568E4A.title": "&2&lAfter all",
  "quest.48767560B4568E4A.quest_subtitle": "&7The final stage of the game.",
  "quest.48767560B4568E4A.quest_desc": [
    "The final stage of the game."
  ],
