  ],
  "quest.469D25CF7BDE4409.title": "&fPlatinum",
  "quest.469D25CF7BDE4409.quest_subtitle": "&7Material for platinum gear.",
  "quest.469D25CF7BDE4409.quest_desc": [
    "&7Material for platinum gear."
  ],
  "quest.4211EC5D1F2E8708.title": "&cIllager Invasion",
  "quest.4211EC5D1F2E8708.quest_subtitle": "&7Lots of new, dangerous illagers.",
  "quest.4211EC5D1F2E8708.quest_desc": [
    "&7Lots of new, dangerous illagers."
  ],
  "chapter.4B2E7C91D05A3F68.title": "&7› &6Horses",
  "quest.41D8E3A72C5B96F0.title": "&eYour horse",
  "quest.41D8E3A72C5B96F0.quest_subtitle": "&7Tame a horse and it becomes yours.",
  "quest.41D8E3A72C5B96F0.quest_desc": [
    "&7Once you finish taming a horse it is &aregistered to you&7.",
    "&7Only you can ride it: anyone else who tries to ride it as the main rider &cgets bucked off&7. It still accepts a second rider behind.",
    "",
    "&7To let a friend ride it alone:",
    "&e/horse trust Name&7 (covers all your horses)",
    "&e/horse untrust Name&7 to revoke it and &e/horse trusted&7 to see the list."
  ],
  "quest.47B05C1E9A3D2864.title": "&eWhistle and commands",
  "quest.47B05C1E9A3D2864.quest_subtitle": "&7Call your horse and command it with the wheel.",
  "quest.47B05C1E9A3D2864.quest_desc": [
    "&e&lWhistle / Info&r&7 (side mouse button): nearby horses follow you and distant ones come closer. While riding, it opens the horse info screen.",
    "&e&lCommand wheel&r&7 (middle mouse button): look at your horse and pick a command.",
    "&e&lManage horses&r&7 (&f]&7): list of all your horses.",
    "&e&lCharge&r&7 (right Alt): the horse rams whatever is in front of you.",
    "&e&lFree look&r&7 (hold left Ctrl while riding): turn the camera without turning the horse.",
    "",
    "&7You can change the keys in Options > Controls > Icy's Better Horses."
  ],
  "quest.4C6A91F3E07D5B28.title": "&eBreeds and classes",
  "quest.4C6A91F3E07D5B28.quest_subtitle": "&715 breeds split into 5 classes.",
  "quest.4C6A91F3E07D5B28.quest_desc": [
    "&7There are &e15 breeds&7 with their own coats and biomes, in five classes:",
    "&6Race&7 (Thoroughbred, Arabian...): the fastest.",
    "&cWar&7 (Friesian, Andalusian...): tough and charge hard.",
    "&8Draft&7 (Percheron, Shire, Clydesdale, Belgian): strong, and the only ones that pull the &elarge cart&7.",
    "&aPonies&7 (Icelandic, Haflinger): small and nimble.",
    "&eWestern&7 (Mustang, Quarter, Paint, Appaloosa, Morgan): well balanced.",
    "",
    "&7Breeding different breeds gives a &dmix&7."
  ],
  "quest.42F7D08B6E1C3A95.title": "&eUpgraded Saddle",
  "quest.42F7D08B6E1C3A95.quest_subtitle": "&7The base of all horse tack.",
  "quest.42F7D08B6E1C3A95.quest_desc": [
    "&7Made from a regular &fsaddle&7, &6copper&7 and a few &bdiamonds&7.",
    "&7Unlocks the horse's &egear slots&7 and shows its stats while held."
  ],
  "quest.4D3B5E92A70C6F14.title": "&eHorseshoe",
  "quest.4D3B5E92A70C6F14.quest_subtitle": "&7A steady step on rough ground.",
  "quest.4D3B5E92A70C6F14.quest_desc": [
    "&7Some &6copper&7 ingots and a leather strap.",
    "&7The horse can walk on &fpowder snow&7 and takes &aless fall damage&7."
  ],
  "quest.48E2C6A0F5913B7D.title": "&eHorse Medkit",
  "quest.48E2C6A0F5913B7D.quest_subtitle": "&7Heals your horse when it is in trouble.",
  "quest.48E2C6A0F5913B7D.quest_desc": [
    "&7Wool, healing supplies and a &dregeneration potion&7.",
    "&7When the horse drops below &chalf health&7 it heals it automatically."
  ],
  "quest.43A9F1D75C08E26B.title": "&eGlidewing Harness",
  "quest.43A9F1D75C08E26B.quest_subtitle": "&7Slows down big falls.",
  "quest.43A9F1D75C08E26B.quest_desc": [
    "&7Mounted on the &eupgraded saddle&7 and crafted from &6canisters&7 (copper and gold).",
    "&7Slows big falls and can &acancel fall damage&7.",
    "&7When it is spent, refuel it on an &fanvil&7 with another canister."
  ],
  "quest.4F05B8C3D2A6971E.title": "&eHorse Cart",
