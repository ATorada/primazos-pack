  "chapter.48B9611DC0D886EC.title": "&bIf you die",
  "quest.4DB9A40D131B98D7.title": "&7If you die: your grave",
  "quest.4DB9A40D131B98D7.quest_subtitle": "&7When you die, a gravestone with ALL your stuff appears where you fell.",
  "quest.4DB9A40D131B98D7.quest_desc": [
    "&7When you die, a gravestone with ALL&r&7 your stuff appears where you fell.",
    "",
    "&7Go back and right-click it to get your stuff back. Nobody else should be able to open it.",
    "",
    "&8Mod: Gravestones"
  ],
  "quest.4F13AE37C252E255.title": "&6Totem from the inventory",
  "quest.4F13AE37C252E255.quest_subtitle": "&7The Totem of Undying works even if it's in your inventory, no…",
  "quest.4F13AE37C252E255.quest_desc": [
    "&7The Totem of Undying works even if it's in your inventory, no need to hold it in your hand.",
    "",
    "&8Mod: Inventory Totem"
  ],
  "quest.4D57FE8694C497E6.title": "&dPets that come back",
  "quest.4D57FE8694C497E6.quest_subtitle": "&7Your tamed pets can come back to life if they die.",
  "quest.4D57FE8694C497E6.quest_desc": [
    "&7Your tamed pets can come back to life if they die.",
    "",
    "&7The Etheric Gem is the key: look up its recipe in &r&dREI&r&7 (R key).",
    "",
    "&8Mod: Respawnable Pets"
  ],
  "quest.4A5518F0139D5407.title": "&aStoring experience",
  "quest.4A5518F0139D5407.quest_subtitle": "&7The Experience Tome (XP Tome)",
  "quest.4A5518F0139D5407.quest_desc": [
    "&r&7The Experience Tome (&r&dXP&r&7 Tome)",
    "&7stores your levels so you don't lose them on death or to pass them to another player.",
    "",
    "&r&8Mod: &r&dXP&r&8 Tome"
  ],
  "quest.44142FAFEF3E3A65.title": "&c&lIf you die",
  "quest.44142FAFEF3E3A65.quest_subtitle": "&7Dying in Primazos isn't the end: your stuff waits for you and the Aegis…",
  "quest.44142FAFEF3E3A65.quest_desc": [
    "Dying in Primazos isn't the end: your stuff waits for you and the &a&lAegis&r&7 helps if you die repeatedly."
  ],
  "chapter.4DB240077E0917AE.title": "&bAegis of Protection",
  "quest.4A7ECEFFB1CE929A.title": "&a&lAegis&r&7",
  "quest.4A7ECEFFB1CE929A.quest_subtitle": "If you die several times in a row.",
  "quest.4A7ECEFFB1CE929A.quest_desc": [
    "When you respawn, the &a&lAegis&r&7 covers you for &d15 minutes&7:",
    "&aSpeed, Regeneration and Strength&7",
    "The more deaths in a row (up to 5), the stronger.",
    "",
    "&eUnderwater, also: &bWater Breathing and Night Vision&7",
    "",
    "&eChance of a &dTOTEM&7&e:",
    "&71: &f5%&7 · 2: &f10%&7 · 3: &f15%&7 · 4: &f25%&7 · 5: &650%",
    "",
    "&8It doesn't trigger if another player kills you."
  ],
  "quest.4676ADFB8603167E.title": "&6Blinded Spawners",
  "quest.4676ADFB8603167E.quest_subtitle": "Spawners spawn fewer monsters.",
  "quest.4676ADFB8603167E.quest_desc": [
    "The &e&lSun's&r&7 rays blind spawners: they spawn far fewer monsters than usual.",
    "",
    "&8Monuments, towers and trial spawners."
  ],
  "quest.4BD515C40CD0CD0C.title": "&bInstant Evaporation",
  "quest.4BD515C40CD0CD0C.quest_subtitle": "Fewer guardians.",
  "quest.4BD515C40CD0CD0C.quest_desc": [
    "If guardians overdo the mitosis (more than 20), the &e&lSun&r&7 evaporates &dHALF&7 of them without a trace."
  ],
  "quest.4C43DF55E70F0A48.title": "&6Lost Rocket",
  "quest.4C43DF55E70F0A48.quest_subtitle": "20% chance for a rocket to fizzle out.",
  "quest.4C43DF55E70F0A48.quest_desc": [
    "Each rocket a pillager fires has a &d20%&7 chance to dissolve into smoke before reaching you."
  ],
  "quest.4E3055876B934EA9.title": "&eDazzle",
  "quest.4E3055876B934EA9.quest_subtitle": "25% chance to dazzle the illager.",
  "quest.4E3055876B934EA9.quest_desc": [
    "When a vindicator, inquisitor or marauder hits you, there's a &d25%&7 chance the &e&lSun&r&7 dazzles it:",
    "&c3 ❤ of damage&7",
    "&bWeak and almost frozen for 10 seconds&7"
  ],
  "quest.4C84E15B6B2634F6.title": "&5Blessed Forge",
  "quest.4C84E15B6B2634F6.quest_subtitle": "20% chance of an extra ingot.",
  "quest.4C84E15B6B2634F6.quest_desc": [
    "When crafting a netherite ingot, there's a &d20%&7 chance the &e&lSun&r&7 gifts you another."
  ],
  "quest.4B16A06875A5D051.title": "&6Warmth of the Sun",
  "quest.4B16A06875A5D051.quest_subtitle": "20% extra scrap.",
  "quest.4B16A06875A5D051.quest_desc": [
    "When taking netherite scrap out of the furnace, each one has a &d20%&7 chance to give you another.",
    "",
    "&8Taking it out yourself: hoppers don't count."
  ],
  "quest.4480F963C9234B4A.title": "&5Blessed Template",
  "quest.4480F963C9234B4A.quest_subtitle": "25% chance of an extra template.",
  "quest.4480F963C9234B4A.quest_desc": [
    "When duplicating a netherite upgrade template, there's a &d25%&7 chance the &e&lSun&r&7 gives you one more."
  ],
  "quest.4A1C7E5D90B3F2A6.title": "&fBlessed Iron",
  "quest.4A1C7E5D90B3F2A6.quest_subtitle": "5% chance of an extra ingot.",
  "quest.4A1C7E5D90B3F2A6.quest_desc": [
    "When smelting iron, each ingot has a &d5%&7 chance the &e&lSun&r&7 gives you one more.",
    "",
    "&8Taking it from the furnace yourself: hoppers don't count."
  ],
  "quest.4C2D8F6E01A4B3B7.title": "&6Blessed Gold",
  "quest.4C2D8F6E01A4B3B7.quest_subtitle": "10% chance of an extra ingot.",
  "quest.4C2D8F6E01A4B3B7.quest_desc": [
    "When smelting gold, each ingot has a &d10%&7 chance the &e&lSun&r&7 gives you one more.",
    "",
    "&8Taking it from the furnace yourself: hoppers don't count."
  ],
  "quest.40D481890F723CF4.title": "&dBroken Brew",
  "quest.40D481890F723CF4.quest_subtitle": "25% chance to break a witch's potion.",
  "quest.40D481890F723CF4.quest_desc": [
    "Each potion a witch throws at you has a &d25%&7 chance to break in mid-air."
  ],
  "quest.4B2CACA647FCCD72.title": "&bBroken Trident",
  "quest.4B2CACA647FCCD72.quest_subtitle": "20% chance to shatter a trident.",
  "quest.4B2CACA647FCCD72.quest_desc": [
    "Each trident a drowned throws has a &d20%&7 chance to shatter into stardust."
  ],
  "quest.44DF2E7F9D84C824.title": "&fLost Arrow",
  "quest.44DF2E7F9D84C824.quest_subtitle": "15% chance to lose an arrow.",
  "quest.44DF2E7F9D84C824.quest_desc": [
    "Each arrow from a skeleton (of any kind) has a &d15%&7 chance to get lost in the night."
  ],
  "quest.4AB2F0C9EB89246A.title": "&aSnuffed Fuse",
  "quest.4AB2F0C9EB89246A.quest_subtitle": "30% chance to defuse a creeper.",
  "quest.4AB2F0C9EB89246A.quest_desc": [
    "When a creeper reaches you, there's a &d30%&7 chance the &d&lStars&r&7 snuff out its fuse."
  ],
  "quest.40511FDA626F7CE1.title": "&7Clear Skies",
  "quest.40511FDA626F7CE1.quest_subtitle": "30% chance to erase a phantom.",
  "quest.40511FDA626F7CE1.quest_desc": [
    "Each phantom that spawns has a &d30%&7 chance of being erased from the sky by the &d&lStars&r&7."
  ],
  "quest.4F47932405EE7D6D.title": "&2Infusion of Undead Life",
  "quest.4F47932405EE7D6D.quest_subtitle": "20% chance to harm the zombie that hits you.",
  "quest.4F47932405EE7D6D.quest_desc": [
    "When a zombie hits you, there's a &d20%&7 chance it receives:",
    "&cInstant Health: 3 ❤ of damage&7",
    "&bSlowness VI for 5 seconds&7"
  ],
  "quest.42B3A405FBB94B9F.title": "&dStellar Recast",
  "quest.42B3A405FBB94B9F.quest_subtitle": "10% chance to repair a piece every 5 min.",
  "quest.42B3A405FBB94B9F.quest_desc": [
    "Every 5 minutes outdoors at night, there's a &d10%&7 chance the &d&lStars&r&7 &dFULLY&7 repair a worn piece.",
    "",
    "&8They can't see you under a roof or in caves."
  ],
  "quest.43D07842A1056114.title": "&dConstellation",
  "quest.43D07842A1056114.quest_subtitle": "More experience in a group.",
  "quest.43D07842A1056114.quest_desc": [
    "The &d&lStars&r&7 are prettier in company. At night, within 32 blocks:",
    "&73 players: &f+25%",
    "&74 or more: &6+50%",
    "",
    "&8You'll see it at the top of the screen."
  ],
  "quest.48352B8BC49CB196.title": "&e&lSun Protection",
  "quest.48352B8BC49CB196.quest_subtitle": "The &e&lSun&r&7&r protects you from excess.",
  "quest.48352B8BC49CB196.quest_desc": [
    "The &e&lSun&r&7 is a benevolent god who watches over the players of Primazos.",
    "",
    "These are their blessings."
  ],
  "quest.43EDB872081104E2.title": "&d&lProtection of the Stars",
  "quest.43EDB872081104E2.quest_subtitle": "The &d&lStars&r&7&r guide those who walk in the dark.",
  "quest.43EDB872081104E2.quest_desc": [
    "The &d&lStars&r&7 are a benevolent god. They don't grant power: they grant guidance, so hard nights are a little easier.",
    "",
    "&fThey only act at night (from dusk) or during a storm."
  ],
  "quest.42283FA0885C276E.title": "&a&lAegis of Protection",
  "quest.42283FA0885C276E.quest_subtitle": "Two benevolent gods watch over Primazos.",
  "quest.42283FA0885C276E.quest_desc": [
    "The &e&lSun&r&7 by day and the &d&lStars&r&7 by night.",
    "",
    "And when everything goes wrong, the &a&lAegis&r&7 covers you."
  ],
  "chapter.49245C1C892580C8.title": "&bScaling monsters",
  "quest.4DC647F23DED0C4B.title": "&eHow it works",
  "quest.4DC647F23DED0C4B.quest_subtitle": "&7Each player goes up 1 level for every 20 minutes played, up to 100.",
  "quest.4DC647F23DED0C4B.quest_desc": [
    "&7Each player goes up 1 level for every 20 minutes played, up to 100.",
    "&7",
    "&7Monsters spawning nearby use the level of the &r&dNEAREST&r&7 player.",
    "&7",
    "&7If you're with a high-level player, monsters around them will be tougher for everyone.",
    "&7",
    "&7In &dYoth&7 it doesn't count: your level &dneither goes up nor down&7 and monsters there don't get stronger."
  ],
  "quest.471998B7E9B2D38F.title": "&2Zombies",
  "quest.471998B7E9B2D38F.quest_subtitle": "&7Level 25: +25% health, +38% damage.",
  "quest.471998B7E9B2D38F.quest_desc": [
    "&7&6&lLevel 25&r&7: &c+25% health&7, &c+38% damage&7.",
    "&7&6&lLevel 50&r&7: &c+50% health&7, &c+75% damage&7.",
    "&7&6&lLevel 100&r&7: &cdouble&7 health and &c+150% damage&7, and they call reinforcements."
  ],
  "quest.4AD5E99117F257D7.title": "&fSkeletons",
  "quest.4AD5E99117F257D7.quest_subtitle": "&7Level 25: +25% health, bow with Power I.",
  "quest.4AD5E99117F257D7.quest_desc": [
    "&7&6&lLevel 25&r&7: &c+25% health&7, bow with &cPower I&7.",
    "&7&6&lLevel 50&r&7: &c+50% health&7, &cPower II&7 and &carmor&7.",
    "&7&6&lLevel 100&r&7: double health, &cPower V&7, Punch and Flame."
  ],
  "quest.40A3F7D3C2DF97E8.title": "&8Spiders",
  "quest.40A3F7D3C2DF97E8.quest_subtitle": "&7The ones that gain the most health:",
  "quest.40A3F7D3C2DF97E8.quest_desc": [
    "&7The ones that gain the most health:",
    "&7&6&lLevel 25&r&7: &c+75% health&7.",
    "&7&6&lLevel 50&r&7: &c+150% health&7.",
    "&7&6&lLevel 100&r&7: &cfour times&7 more health."
  ],
  "quest.4EAB4B2498695AF2.title": "&aCreepers",
  "quest.4EAB4B2498695AF2.quest_subtitle": "&7They explode sooner and harder.",
  "quest.4EAB4B2498695AF2.quest_desc": [
    "&7They explode sooner and harder.",
    "&7&6&lLevel 50&r&7: explosion radius 4.",
    "&7&6&lLevel 100&r&7: radius 6 and a much shorter fuse."
  ],
  "quest.4D60181555FDC5B2.title": "&bGuardians",
  "quest.4D60181555FDC5B2.quest_subtitle": "&7Level 50: +75% health and armor.",
  "quest.4D60181555FDC5B2.quest_desc": [
    "&7&6&lLevel 50&r&7: &c+75% health and &carmor&7&7.",
    "&7&6&lLevel 100&r&7: &c+150% health and +25% damage&7."
  ],
  "quest.43BAF7436C24984B.title": "&3Drowned",
  "quest.43BAF7436C24984B.quest_subtitle": "&7Level 50: +75% health, half carry a trident.",
  "quest.43BAF7436C24984B.quest_desc": [
    "&7&6&lLevel 50&r&7: &c+75% health&7, half of them carry a &ctrident&7.",
    "&7&6&lLevel 100&r&7: &c+150% health and all with a &ctrident&7&7."
  ],
  "quest.4BD80EE2EF4F3106.title": "&7Pillagers and illagers",
  "quest.4BD80EE2EF4F3106.quest_subtitle": "&7More health, armor and damage. Pillagers even shoot firework…",
  "quest.4BD80EE2EF4F3106.quest_desc": [
