  "quest.4808884CA6FC720E.title": "&e&lCrossing the Veil",
  "quest.4808884CA6FC720E.quest_subtitle": "&7Only when the Veil weakens:",
  "quest.4808884CA6FC720E.quest_desc": [
    "&r&7Only when the &r&e&lVeil&r&7 weakens:",
    "&7the chat warns you with a green message and a chorus of whispers.",
    "",
    "&r&7Climb up to the &r&eworld's ceiling&r&7 and keep going up to cross.",
    "",
    "&7You reach the islands, not the top.",
    "&r&7If you fall into the void, you return to the &r&bOverworld&r&7.",
    "",
    "&r&7With the &r&e&lVeil&r&7 closed, an invisible force holds you back."
  ],
  "quest.44411FC6C725352F.title": "&5&lBeings from the other side",
  "quest.44411FC6C725352F.quest_subtitle": "&7Overworld mobs born there are corrupted by a power…",
  "quest.44411FC6C725352F.quest_desc": [
    "&7Overworld mobs born there are &r&e&lcorrupted&r&7 by a power they cannot withstand, and they &r&e&looze&r&7.",
    "",
    "&r&7They stay that way even if you &r&ftame&r&7 them.",
    "&7They whisper when you're nearby.",
    "",
    "&r&7Mobs native to &r&aAerial Hell&r&7 don't change."
  ],
  "quest.4EAA13D611CE5347.title": "&2&lDivine Corruption",
  "quest.4EAA13D611CE5347.quest_subtitle": "&7The touch of the corrupted beings.",
  "quest.4EAA13D611CE5347.quest_desc": [
    "&7The touch of the corrupted beings.",
    "",
    "&r&7Duration: &r&f7 s",
    "&r&7Damage: &r&f1 per second&r&7 (+0.5 per level, up to level &r&f3&r&7)",
    "&r&7Pierces armor; only &r&bProtection reduces it.",
    "&r&7Never kills: it stops at &r&c1 heart&r&7.",
    "",
    "&r&a&lImmunity: &r&72 Broken Veil pieces."
  ],
  "quest.4BD2F98DE32C556F.title": "&e&lForging the Broken Veil",
  "quest.4BD2F98DE32C556F.quest_subtitle": "&71. Defeat a divine echo: it drops its crystal.",
  "quest.4BD2F98DE32C556F.quest_desc": [
    "&r&71. Defeat a &r&ddivine echo&r&7: it drops its &r&ecrystal&r&7.",
    "&r&72. &r&eCrystal&r&7 + netherite and siftite ingot = &r&aBroken Veil ingot&r&7.",
    "&r&73. &r&bSmithing Table&r&7: netherite and siftite piece + netherite template + Broken Veil ingot."
  ],
  "quest.41F63852B02F57EE.title": "&e&lAerial Hell",
  "quest.41F63852B02F57EE.quest_subtitle": "&7Beyond the veil, the sky no longer belongs to those who tended it.",
  "quest.41F63852B02F57EE.quest_desc": [
    "&7Beyond the veil, the sky no longer belongs to those who tended it.",
    "",
    "&r&7The &r&5&ldemons from outside&r&7 found this corner of the world, corrupted the beings of the sky and rule the lesser ones with whispers.",
    "",
    "&r&7They hid behind a &r&e&lVeil&r&7.",
    "&r&7Today, sometimes, the &r&e&lVeil&r&7 weakens."
  ],
  "quest.4160F2D432C5E4CA.title": "&2&lThe biome on the other side",
