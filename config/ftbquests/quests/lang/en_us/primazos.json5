  "chapter.4D9A475CF55E2077.title": "&7› &6Useless Reptile",
  "quest.4EB01E40F3569BDA.title": "&2Swamp wyvern",
  "quest.4EB01E40F3569BDA.quest_subtitle": "&7Where: swamps.",
  "quest.4EB01E40F3569BDA.quest_desc": [
    "&bWhere: swamps.",
    "&eTaming it:",
    "&r&7Give it 1-2 stacks of &r&dchicken&r&7 (raw or cooked) or 4 stacks of any other meat (rotten flesh works).",
    "&eItems:",
    "&r&dSaddle&r&7 or &r&dDouble&r&7 &r&dSaddle&r&7 (for two riders). With an &r&dempty&r&7 &r&dbottle&r&7 you collect acid, which works like a potion.",
    "&r&dCANNOT&r&7 wear armor.",
    "&eAbilities (G and R):",
    "&r&7Spits &r&dacid&r&7 balls (so-so aim) and bites."
  ],
  "quest.4028E6C369FD4CB0.title": "&eLightning Chaser",
  "quest.4028E6C369FD4CB0.quest_subtitle": "&7Where: appears during storms near players.",
  "quest.4028E6C369FD4CB0.quest_desc": [
    "&bWhere: spawns during storms near players.",
    "&eTaming it:",
    "&7You have to beat it: lower its health and strike it with &r&d3&r&7 &r&dlightning bolts&r&7 (trident with &r&dChanneling&r&7).",
    "&eItems:",
    "&r&dSaddle&r&7, &r&ddragon&r&7 &r&darmor&r&7 &r&d(helmet, chestplate and tail in iron, gold, diamond or netherite) and banners.",
    "&eAbilities (G and R):",
    "&r&dBreath&r&7 &r&dof&r&7 &r&dlightning&r&7: breaks blocks and does the same as lightning (charged creepers, witches...).",
    "&r&dShock&r&7 &r&dwave&r&7 (only while flying):",
    "&7deflects arrows and pushes mobs away.",
    "&7On the ground, it bites.",
    "&r&7Both attacks inflict &r&dShock&r&7: the enemy moves slower, hits weaker and sees worse."
  ],
  "quest.4262A3CF669E9159.title": "&6Moleclaw",
  "quest.4262A3CF669E9159.quest_subtitle": "&7Where: caves.",
  "quest.4262A3CF669E9159.quest_desc": [
    "&bWhere: caves.",
    "&eTaming it:",
    "&7Feed it on average a stack of beetroot&r&7.",
    "&eItems:",
    "&r&dSaddle&r&7, &r&ddragon&r&7 &r&darmor&r&7 &r&dand&r&7 &r&dits &r&dMoleclaw&r&7 &r&dhelmet&r&7: without the helmet it's afraid of light.",
    "&eAbilities (G and R):",
    "&r&dDigs&r&7 whatever a wooden pickaxe breaks. With a &r&dStrength&r&7 potion it breaks harder blocks; with &r&dWeakness it breaks nothing.",
    "&7Melee attacks that hit everything in front of you."
  ],
  "quest.4AA866B9AC7C316F.title": "&bRiver Pikehorn",
  "quest.4AA866B9AC7C316F.quest_subtitle": "&7Where: rivers and beaches that aren't frozen.",
  "quest.4AA866B9AC7C316F.quest_desc": [
    "&bWhere: rivers and beaches that aren't frozen.",
    "&eTaming it:",
    "&r&7A &r&dbucket&r&7 &r&dof&r&7 &r&dtropical&r&7 &r&dfish&r&7 or 4-8 tropical fish.",
    "&eItems:",
    "&r&7With the &r&dFlute&r&7 you order it to fish for you or attack a mob.",
    "&r&dCANNOT&r&7 be ridden: it's worn on your head (sneak and click a block to put it on or take it off).",
    "&eAbilities:",
    "&7Only attacks in melee."
  ],
  "quest.466A8F910111B077.title": "&cMagmamuncher",
  "quest.466A8F910111B077.quest_subtitle": "&7Where: Nether, near lava lakes.",
  "quest.466A8F910111B077.quest_desc": [
    "&bWhere: Nether, near lava lakes.",
    "&eTaming it:",
    "&r&7Give it between 4 and 12 &r&dblaze&r&7 &r&drods&r&7.",
    "&eItems:",
    "&r&dCANNOT&r&7 be ridden: it's worn on your head like the Pikehorn.",
    "&r&7If it has &r&dfuel&r&7 in its inventory (coal...), it gives you&r&7 &r&dFire&r&7 &r&dResistance&r&7 when you catch fire.",
    "&eAbilities:",
    "&7Digs magma blocks (sometimes gets coal). Its bites burn and it's immune to fire."
  ],
  "quest.4F3998BAF5DA2293.title": "&eOrders and care",
  "quest.4F3998BAF5DA2293.quest_subtitle": "&7Works for all tamed dragons:",
  "quest.4F3998BAF5DA2293.quest_desc": [
    "&7Works for all tamed dragons:",
    "",
    "&r&dSneak&r&7 &r&d+&r&7 &r&dright&r&7 &r&dclick&r&7:",
    "&7open its inventory and give it orders (follow, stay, sit).",
    "&r&dStick&r&7 or horn while sneaking: make it sit or stand.",
    "&7Sneak to give potions to the dragon.",
    "&7If you put food in its inventory, it eats on its own."
  ],
  "quest.42CD36F88043CB23.title": "&bDragon armor",
  "quest.42CD36F88043CB23.quest_subtitle": "&7Helmet, chestplate and tail in iron, gold, diamond or netherite (the…",
  "quest.42CD36F88043CB23.quest_desc": [
    "&7Helmet, chestplate and tail in iron, gold, diamond or netherite (the netherite one, at the smithing table).",
    "",
    "&r&7Only for the &r&dLightning&r&7 &r&dChaser&r&7 and the &r&dMoleclaw&r&7."
  ],
  "quest.47518FCD7A890C0F.title": "&7Moleclaw helmet",
  "quest.47518FCD7A890C0F.quest_subtitle": "&7Makes the Moleclaw not afraid of light.",
  "quest.47518FCD7A890C0F.quest_desc": [
    "&7Makes the Moleclaw not afraid of light."
  ],
  "quest.4E656E9748B1534E.title": "&6Double mount",
  "quest.4E656E9748B1534E.quest_subtitle": "&7Wyvern only: lets two players ride at once.",
  "quest.4E656E9748B1534E.quest_desc": [
    "&7Wyvern only: lets two players ride at once."
  ],
  "quest.41A856F95FB3CC76.title": "&eFlute",
  "quest.41A856F95FB3CC76.quest_subtitle": "&7Gives orders from a distance: call, sit, stand, attack or fish.",
  "quest.41A856F95FB3CC76.quest_desc": [
    "&7Gives orders from a distance: call, sit, stand, attack or fish.",
    "",
    "&r&dSneak&r&7 &r&d+&r&7 &r&dright&r&7 &r&dclick&r&7 &r&din the air&r&7: change command.",
    "&r&dRight&r&7 &r&dclick&r&7 &r&don&r&7 &r&da&r&7 &r&ddragon&r&7:",
    "&7choose which type of dragon you command."
  ],
  "quest.479914831587CC98.title": "&dVortex horn",
  "quest.479914831587CC98.quest_subtitle": "&7Upgraded goat horn that STORES your dragons inside to…",
  "quest.479914831587CC98.quest_desc": [
    "&7Upgraded goat horn that STORES&r&7 your dragons inside so you can take them with you.",
    "",
    "&7There are iron, gold, diamond and netherite versions: the better it is, the more dragons fit."
  ],
  "quest.473E7C48EF200BEC.title": "&6Calling your dragon",
  "quest.473E7C48EF200BEC.quest_subtitle": "&7Right-click your dragon with a goat horn to…",
  "quest.473E7C48EF200BEC.quest_desc": [
    "&r&7Right-click your dragon with a &r&dgoat&r&7 &r&dhorn&r&7 to bind it.",
    "",
    "&7When you blow this horn, your dragon will come even if it is sitting."
  ],
  "quest.455D7936C805FA99.title": "&2Wyvern skin",
  "quest.455D7936C805FA99.quest_subtitle": "&7Only good for getting 2 leather.",
  "quest.455D7936C805FA99.quest_desc": [
    "&7Only good for getting 2 leather."
  ],
  "quest.42C5627372EC7267.title": "&6Riding controls",
  "quest.42C5627372EC7267.quest_subtitle": "&7W/S move · Ctrl descend",
  "quest.42C5627372EC7267.quest_desc": [
    "&r&dW/S&r&7 move · &r&dCtrl&r&7 descend",
    "&r&dG&r&7 and &r&dR&r&7 abilities · &r&dZ&r&7 free look",
    "",
    "&7Dragons don't move sideways.",
    "&7Change keys in Options > Controls."
  ],
