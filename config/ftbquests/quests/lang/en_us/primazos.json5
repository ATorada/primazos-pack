    "",
    "&7Lots of glacial skeletons: their arrows slow you down."
  ],
  "quest.4516D98A21B7DF58.title": "&fEnd castle, ship and lighthouse (D＆T)",
  "quest.4516D98A21B7DF58.quest_subtitle": "&7Where: End",
  "quest.4516D98A21B7DF58.quest_desc": [
    "&bWhere: End",
    "&fMobs: shulkers, endermites, phantoms",
    "&cOver 60 mobs can pile up:",
    "&clag!",
    "",
    "&7Shulkers that make you levitate over the void. Bring Feather Falling and blocks."
  ],
  "quest.40D015B43B7C1AC4.title": "&fPiglin camps (D＆T)",
  "quest.40D015B43B7C1AC4.quest_subtitle": "&7Where: Nether",
  "quest.40D015B43B7C1AC4.quest_desc": [
    "&bWhere: Nether",
    "&fMobs: piglins, magma cubes, piglin brutes, hoglins",
    "&cOver 60 mobs can pile up:",
    "&clag!",
    "",
    "&7Barbarian piglins: they hit really hard.",
    "&7A gold piece is a must."
  ],
  "quest.45B50862D75D33B6.title": "&fStronghold variants (RS)",
  "quest.45B50862D75D33B6.quest_subtitle": "&7Where: End, Nether",
  "quest.45B50862D75D33B6.quest_desc": [
    "&bWhere: End, Nether",
    "&fMobs: endermites, blazes, endermen, wither skeletons",
    "&cOver 60 mobs can pile up:",
    "&clag!",
    "",
    "&7The Nether one is full of blaze spawners."
  ],
  "quest.488258276014F847.title": "&fBunker, catacombs and crypts (D＆T)",
  "quest.488258276014F847.quest_subtitle": "&7Where: Overworld",
  "quest.488258276014F847.quest_desc": [
    "&bWhere: Overworld",
    "&fMobs: skeletons, zombies, spiders, creepers",
    "&cOver 60 mobs can pile up:",
    "&clag!",
    "",
    "&7Narrow corridors with lots of spawners."
  ],
  "quest.4B90B95AB7CD8586.title": "&fTrident Monument (D＆T)",
  "quest.4B90B95AB7CD8586.quest_subtitle": "&7Where: Overworld",
  "quest.4B90B95AB7CD8586.quest_desc": [
    "&bWhere: Overworld",
    "&9Underwater: 65% of the structure",
    "&fMobs: guardians, drowned, elder guardians",
    "&6Many mobs can gather at once.",
    "",
    "&7Huge and almost entirely underwater.",
    "&7Toned down on this server: few guardians (there used to be dozens).",
    "&7Full of drowned with tridents.",
    "&7Water Breathing is a must."
  ],
  "quest.4A8673E476997357.title": "&4Very hard",
  "quest.4A8673E476997357.quest_subtitle": "&7Recommended gear:",
  "quest.4A8673E476997357.quest_desc": [
    "&eRecommended gear:",
    "&7Enchanted advanced netherite (Protection IV), totems, potions and a group of 3 or more.",
    "",
    "&710 structure groups."
  ],
  "chapter.43D8126DC96590CE.title": "&7› &6Raids and illagers",
  "quest.4C184774761E4952.title": "&cPillager rockets",
  "quest.4C184774761E4952.quest_subtitle": "&7Every 10 levels of the NEAREST player, their rockets carry a…",
  "quest.4C184774761E4952.quest_desc": [
    "&r&7Every 10 levels of the &r&dNEAREST&r&7 player, their rockets carry one more explosion.",
    "&7From level 75 they fire 3 rockets at once.",
    "",
    "&eRocket damage on hard:",
    "&r&7Level 20: &r&c6.8 ❤&r&7   Level 40: &r&c9.8 ❤ Level 60: &r&c12.8 ❤&r&7   Level 90: &r&c17.3 ❤",
    "",
    "&7They explode in an area. You have 10 ❤ in total.",
    "",
    "&r&7Lost Rocket: the &r&e&lSun&r&7 undoes 20% of rockets before they land."
  ],
  "quest.4E8F409FF7102984.title": "&fWith IRON armor",
  "quest.4E8F409FF7102984.quest_subtitle": "&7A level 60 rocket takes away:",
  "quest.4E8F409FF7102984.quest_desc": [
    "&7A level 60 rocket takes away:",
    "",
    "&r&7Unenchanted → &r&c11.2 ❤",
    "&r&eProtection IV ×4 → &r&c4 ❤",
    "&r&aBlast Prot. IV ×4 → &r&c2.2 ❤",
    "",
    "&7Without enchantments, a single rocket kills you."
  ],
  "quest.471D2D91C7F7E177.title": "&bWith DIAMOND armor",
  "quest.471D2D91C7F7E177.quest_subtitle": "&7A level 60 rocket takes away:",
  "quest.471D2D91C7F7E177.quest_desc": [
    "&7A level 60 rocket takes away:",
    "",
    "&r&7Unenchanted → &r&c5.8 ❤",
    "&r&eProtection IV ×4 → &r&c2.1 ❤ Blast Prot. IV ×4 → &r&c1.2 ❤"
  ],
  "quest.44D107455EA71E9B.title": "&6With NETHERITE armor",
  "quest.44D107455EA71E9B.quest_subtitle": "&7A level 60 rocket takes away:",
  "quest.44D107455EA71E9B.quest_desc": [
    "&7A level 60 rocket takes away:",
    "",
    "&r&7Unenchanted → &r&c5.2 ❤",
    "&r&eProtection IV ×4 → &r&c1.9 ❤ Blast Prot. IV ×4 → &r&c1 ❤"
  ],
  "quest.48A5F45DC2AE4CBC.title": "&dWith NETHERITE AND DIAMOND",
  "quest.48A5F45DC2AE4CBC.quest_subtitle": "&7A level 60 rocket takes away:",
  "quest.48A5F45DC2AE4CBC.quest_desc": [
    "&7A level 60 rocket takes away:",
    "",
    "&r&7Unenchanted → &r&c2.5 ❤",
    "&r&eProtection IV ×4 → &r&c0.9 ❤ Blast Prot. IV ×4 → &r&c0.5 ❤",
    "",
    "&7Already reaches max protection against this rocket. Aeternium-netherite and siftite-netherite handle even stronger hits better."
  ],
  "quest.46F70611939EB189.title": "&aHow to protect yourself",
  "quest.46F70611939EB189.quest_subtitle": "&7Rockets count as EXPLOSIONS: Blast Protection…",
  "quest.46F70611939EB189.quest_desc": [
    "&7Rockets count as EXPLOSIONS&r&7: Blast Protection stops them much better than regular Protection.",
    "",
    "&r&7Dazzle: sometimes the &r&e&lSun stops vindicators, inquisitors and marauders.",
    "",
    "&r&7The &r&dSHIELD&r&7 blocks rockets head-on.",
    "",
    "&7Go with the LOWEST&r&7-level player nearby: pillagers use the nearest player's level."
  ],
  "quest.46E15D7D143DFD32.title": "&aRewards for winning",
  "quest.46E15D7D143DFD32.quest_subtitle": "&7Hero of the Village:",
  "quest.46E15D7D143DFD32.quest_desc": [
    "&eHero of the Village:",
    "&r&7Villagers give you &r&dDISCOUNTS&r&7 and throw you gifts. The stronger the Bad Omen, the better the discount.",
    "",
    "&7Also, illagers drop their loot: the Evoker a &r&dTOTEM&r&7, the ravager a mount, the captain an ominous bottle...",
    "",
    "&eof each one."
  ],
  "quest.4C250AE8D861CDB0.title": "&6Raids (village attacks)",
  "quest.4C250AE8D861CDB0.quest_subtitle": "&7Pillagers shoot ROCKETS that scale with your level, and they come…",
  "quest.4C250AE8D861CDB0.quest_desc": [
    "&r&7Pillagers fire &r&dROCKETS that scale with your level, and new illagers from Illager Invasion show up.",
    "",
    "&eprotect yourself"
  ],
  "task.42BF9B3DB005E90C.title": "Kill a pillager",
  "quest.40603EDA0B76B8FC.title": "&7Pillager",
  "quest.40603EDA0B76B8FC.quest_subtitle": "&7Health: 12 ❤",
  "quest.40603EDA0B76B8FC.quest_desc": [
    "&r&7Health: &r&f12 ❤",
    "&r&7Attack: &r&carrows and ROCKETS (3 ❤ to 17 ❤)",
    "&r&7Drops: &r&aarrows, sometimes its crossbow",
    "",
    "&7Rockets scale with level: check the Raids menu."
  ],
  "task.4EDC9EB136AEF4BE.title": "Kill a vindicator",
  "quest.449A36616B5F60EE.title": "&7Vindicator",
  "quest.449A36616B5F60EE.quest_subtitle": "&7Health: 12 ❤",
  "quest.449A36616B5F60EE.quest_desc": [
    "&r&7Health: &r&f12 ❤",
    "&r&7Attack: &r&caxe, 9.8 ❤ per hit Drops: &r&aemerald, sometimes its axe",
    "",
    "&7At level 50: +50% health and +24% damage.",
    "&r&7Level 100: they carry a &r&dTOTEM&r&7."
  ],
  "task.48AC83C7E1380EAB.title": "Kill an evoker",
  "quest.4E089140E36D02D8.title": "&5Evoker",
  "quest.4E089140E36D02D8.quest_subtitle": "&7Health: 12 ❤",
  "quest.4E089140E36D02D8.quest_desc": [
    "&r&7Health: &r&f12 ❤",
    "&r&7Attack: &r&cfangs, 3 ❤, and summons vexes Drops: &r&aTotem of Undying always, emerald"
  ],
  "task.48DB371C93949588.title": "Kill a vex",
  "quest.41D88D2BD970804B.title": "&bVex",
  "quest.41D88D2BD970804B.quest_subtitle": "&7Health: 7 ❤",
  "quest.41D88D2BD970804B.quest_desc": [
    "&r&7Health: &r&f7 ❤",
    "&r&7Attack: &r&c6.8 ❤ per hit, goes through walls Drops: &r&anothing"
  ],
  "task.43CEE54DB5D3ABE1.title": "Kill a ravager",
  "quest.4FB689A1C2D793D6.title": "&8Ravager",
  "quest.4FB689A1C2D793D6.quest_subtitle": "&7Health: 50 ❤",
  "quest.4FB689A1C2D793D6.quest_desc": [
    "&r&7Health: &r&f50 ❤",
    "&r&7Attack: &r&c9 ❤ per hit, breaks your shield Drops: &r&asaddle"
  ],
  "task.42B627A560B48BBC.title": "Kill a witch",
  "quest.4A7F51591860062B.title": "&2Witch",
  "quest.4A7F51591860062B.quest_subtitle": "&7Health: 13 ❤",
  "quest.4A7F51591860062B.quest_desc": [
    "&r&7Health: &r&f13 ❤",
    "&r&7Attack: &r&cpotions (3 ❤ damage, poison, slowness)",
    "&r&7Drops: &r&apotions, gunpowder, redstone, sugar..."
  ],
  "task.4981D5BDA855E19A.title": "Kill an illusioner",
  "quest.419C5F27909E5EBD.title": "&9Illusioner",
  "quest.419C5F27909E5EBD.quest_subtitle": "&7Health: 12 ❤",
  "quest.419C5F27909E5EBD.quest_desc": [
    "&r&7Health: &r&f12 ❤",
    "&r&7Attack: &r&carrows, copies of itself and blindness Drops: &r&aTOTEM of Illusion, emerald, arrows",
    "",
    "&8Friends ＆ Foes"
  ],
  "task.4819542653CE7ACF.title": "Kill an iceologer",
  "quest.44332876F45AC625.title": "&bIceologer",
