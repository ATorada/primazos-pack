  "quest.47EA464092934E28.title": "&eHorn of sight",
  "quest.47EA464092934E28.quest_subtitle": "&7Reveals nearby enemies.",
  "quest.47EA464092934E28.quest_desc": [
    "&7Reveals nearby enemies."
  ],
  "quest.4860C026AA83B6E6.title": "&bSacred gem",
  "quest.4860C026AA83B6E6.quest_subtitle": "&7Rare illager material.",
