  "quest.4BD494F68908729F.title": "&fFrozen forts and citadel (D＆T)",
  "quest.4BD494F68908729F.quest_subtitle": "&7Where: Overworld",
  "quest.4BD494F68908729F.quest_desc": [
    "&bWhere: Overworld",
    "&fMobs: strays, zombie villagers, parched skeletons, bogged",
    "&cOver 60 mobs can pile up:",
