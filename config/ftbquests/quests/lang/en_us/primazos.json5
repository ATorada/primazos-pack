  "quest.4C692BC8BC9736ED.quest_desc": [
    "&7It's a Vanilla Plus: it plays like normal Minecraft, but with more biomes, mobs, dungeons and quality-of-life features.",
    "",
    "&7First: wood, stone tools, food and a bed."
  ],
